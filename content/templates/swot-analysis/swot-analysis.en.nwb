":"shape","kind":"ellipse","width":160,"text":"","attachedFrame":"A88YbHzs6qqDR8j4GSAUb"},{"id":"DAwTS5CmESVQtFFwqY2sk","fillColor":"#00bcd4","height":80,"position":{"x":10280,"y":5070},"type":"shape","kind":"ellipse","width":160,"text":"","attachedFrame":"A88YbHzs6qqDR8j4GSAUb"},{"id":"LNpXLc2wM41w_T-EaL4ej","fillColor":"#e91e63","height":80,"position":{"x":10360,"y":5910},"type":"shape","kind":"ellipse","width":160,"text":"","attachedFrame":"A88YbHzs6qqDR8j4GSAUb"},{"id":"JACzs2A1sBHCaPRacy29D","fillColor":"#e91e63","height":80,"position":{"x":10320,"y":5870},"type":"shape","kind":"ellipse","width":160,"text":"","attachedFrame":"A88YbHzs6qqDR8j4GSAUb"},{"id":"RxZRd3A_8Re3bP4TJFozd","fillColor":"#e91e63","height":80,"position":{"x":10280,"y":5830},"type":"shape","kind":"ellipse","width":160,"text":"","attachedFrame":"A88YbHzs6qqDR8j4GSAUb"},{"id":"Gk00RYa349hhGLqdX1WN_","position":{"x":9560,"y":4990},"type":"path","kind":"line","strokeColor":"#9e9e9e","points":[{"x":0,"y":0},{"x":0,"y":1000}],"attachedFrame":"A88YbHzs6qqDR8j4GSAUb"},{"id":"NOX5LhYim7iErEO-DRKrd","position":{"x":8680,"y":5510},"type":"path","kind":"line","strokeColor":"#9e9e9e","points":[{"x":0,"y":0},{"x":1800,"y":0}],"attachedFrame":"A88YbHzs6qqDR8j4GSAUb"},{"id":"lG-chnHHs4Rr4R3rVpvQo","attachedFrame":"A88YbHzs6qqDR8j4GSAUb","fillColor":"#d7dee2","height":140,"position":{"x":8640,"y":4770},"type":"shape","kind":"rectangle","width":60,"text":"","textColor":"#8e3013","textFontFamily":"Inter","textSize":64},{"id":"sUlNlUGJGyF2ssDPw4v1J","attachedFrame":"A88YbHzs6qqDR8j4GSAUb","fillColor":"#d7dee2","height":140,"position":{"x":8700,"y":4770},"type":"shape","kind":"rectangle","width":1860,"text":"SWOT Analysis","textSize":64,"textBold":true,"textAlignment":"left"},{"id":"YKenLZsPyquK5lsj6Hiuy","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Facilitation guide","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"KQmJc2Or9LnZaVFAnNIRU","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"H2ONR-AkawRFRbOsHJLHa","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1065,"fillColor":"transparent","text":"🚀 SWOT Analysis: How it works in 4 steps\n\n🎯 Purpose: Get a shared picture of where an organisation, team or project stands.\n\n1. Set the focus (5 min)\nAction: Name the subject of the analysis and the time horizon.\n\n2. Look inside (15 min)\nAction: Collect Strengths (purple) and Weaknesses (cyan).\nRule: Internal factors only, things you can influence.\n\n3. Look outside (15 min)\nAction: Collect Opportunities (yellow-green) and Threats (pink).\nRule: External factors only: market, technology, regulation.\n\n4. Sharpen (15 min)\nAction: Cluster duplicates and dot-vote the 3 most important points per quadrant.\nGoal: A prioritised SWOT ready for the SWOT Strategy board.\n\n🛠️ Your role as facilitator\nSorter: Move cards that are in the wrong quadrant (internal vs. external).\nBalance keeper: Make sure all four quadrants get enough attention.\nBridge builder: Hand the results over to strategy work.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"KQmJc2Or9LnZaVFAnNIRU","textSize":30,"textColor":"#000000"}]}]}}