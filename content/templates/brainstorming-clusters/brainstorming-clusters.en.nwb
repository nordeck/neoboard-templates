ttachedElements":["jiTRhknVt7WqLLzvgvTH1","6LbVfbI2UPjgMXST4T7l5"]},{"id":"jiTRhknVt7WqLLzvgvTH1","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Facilitation guide","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"48xSnCb4c7syCRqBJ0oGC"},{"id":"6LbVfbI2UPjgMXST4T7l5","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 Idea clusters: How it works in 4 steps\n\n🎯 Purpose: Collect many ideas on one question and sort them by theme right away.\n\n1. Set the question (2 min)\nAction: Write the guiding question into the yellow box at the top.\n\n2. Collect in silence (5–10 min)\nAction: Everyone writes ideas on sticky notes, one idea per note. Copy the stacks in the clusters.\nRule: Quantity before quality. No judging yet.\n\n3. Cluster (10–15 min)\nAction: Move similar ideas into one cluster and give each cluster a heading.\nTip: Colours help to show where an idea comes from or what kind it is, e.g. one colour per team.\n\n4. Prioritise (5 min)\nAction: Everyone gives three dots to the most promising ideas or clusters.\n\n🛠️ Your role as facilitator\nTimekeeper: Keep the phases strictly apart.\nStructurer: Name the clusters together with the group, not for it.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"48xSnCb4c7syCRqBJ0oGC"}]}]}}