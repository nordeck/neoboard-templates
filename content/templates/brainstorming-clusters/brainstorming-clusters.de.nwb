ttachedElements":["6FMBXEfwlib44MorAjy0s","O8fASamA7xa87TOJSdWuM"]},{"id":"6FMBXEfwlib44MorAjy0s","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Methodenbeschreibung","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"p0jmCWVgVpIqn9dUdI4ie"},{"id":"O8fASamA7xa87TOJSdWuM","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 Ideen-Cluster: Der Ablauf in 4 Schritten\n\n🎯 Wofür: Viele Ideen zu einer Frage sammeln und gleich nach Themen ordnen.\n\n1. Frage festlegen (2 Min.)\nAktion: Schreiben Sie die Leitfrage in das gelbe Feld oben.\n\n2. Still sammeln (5–10 Min.)\nAktion: Jede Person schreibt Ideen auf Haftnotizen, eine Idee pro Notiz. Kopieren Sie dazu die Stapel in den Feldern.\nRegel: Menge vor Qualität. Noch nicht bewerten.\n\n3. Clustern (10–15 Min.)\nAktion: Ordnen Sie ähnliche Ideen einem Feld zu und geben Sie jedem Cluster eine Überschrift.\nTipp: Die Farben helfen, Herkunft oder Art der Idee zu erkennen, etwa eine Farbe pro Team.\n\n4. Gewichten (5 Min.)\nAktion: Jede Person vergibt drei Punkte an die vielversprechendsten Ideen oder Cluster.\n\n🛠️ Ihre Rolle als Moderation\nZeitwächter: Halten Sie die Phasen strikt getrennt.\nStrukturgeber: Benennen Sie Cluster gemeinsam mit der Gruppe, nicht für sie.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"p0jmCWVgVpIqn9dUdI4ie"}]}]}}