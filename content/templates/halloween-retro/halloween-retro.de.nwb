":5658},"width":120,"height":120,"text":"📜","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"yEL7nIYppa8WNCYoCsEs3"},{"id":"EpH3XEW6RMZpUxWYAszfL","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10360,"y":5670},"width":120,"height":120,"text":"📜","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"yEL7nIYppa8WNCYoCsEs3"},{"id":"zHEunuigIAxMy77DUu5NU","type":"frame","position":{"x":10680,"y":4770},"width":1800,"height":1260,"attachedElements":["MRNhhD1caU209Y2oU1saP","TL0WkJiNMV1NdJ9XSO319"]},{"id":"MRNhhD1caU209Y2oU1saP","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Methodenbeschreibung","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"zHEunuigIAxMy77DUu5NU"},{"id":"TL0WkJiNMV1NdJ9XSO319","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 Halloween-Retro: Der Ablauf in 5 Schritten\n\n🎯 Wofür: Eine Retrospektive mit Gruselfaktor: Was war süß, was ist faul, welche Ideen sollen abheben, und was brauen wir als Nächstes?\n\n1. Einstimmen (5 Min.)\nAktion: Tragen Sie oben den Zeitraum ein. Kurze Runde: Als welche Halloween-Figur kommst du heute in die Retro?\nRegel: Offen, wertschätzend, ohne Schuldzuweisung.\n\n2. Sammeln (10 Min., in Stille)\nAktion: Jeder kopiert Karten von den Stapeln: Schokoriegel 🍫 in den guten Kürbis, faule Tomaten 🍅 in den faulen Kürbis, Ideen 💡 auf den Hexenbesen.\nRegel: Ein Gedanke pro Karte.\n\n3. Vorstellen und clustern (15 Min.)\nAktion: Reihum stellt jeder seine Karten kurz vor. Ähnliches wird zusammengeschoben.\n\n4. Priorisieren (5 Min.)\nAktion: Dot-Voting auf Tomaten und Ideen, z. B. 3 Punkte pro Person.\n\n5. Brauen (15 Min.)\nAktion: Für die Top-Themen kommen Rezeptkarten 📜 in den Hexenkessel: Was, wer, bis wann?\nZiel: 1–3 Maßnahmen, die bis zur nächsten Retro wirklich umgesetzt sind.\n\n🛠️ Ihre Rolle als Moderation\nSpukmeister: Sorgen Sie für Spaß, ohne dass ernste Themen untergehen.\nZeitwächter: Reservieren Sie genug Zeit für den Hexenkessel.\nNachhalter: Starten Sie die nächste Retro mit einem Blick in den Kessel.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"zHEunuigIAxMy77DUu5NU"}]}]}}