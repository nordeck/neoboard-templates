old":true,"textAlignment":"center","textColor":"#000000","attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"PjFBWUiYNs_awXIiy5wTS","type":"shape","kind":"rectangle","fillColor":"#d9cded","position":{"x":9936,"y":5180},"width":584,"height":380,"text":"","textFontFamily":"Inter","borderRadius":12,"attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"AYgw4osnEPtbmJE_BSrCE","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":9956,"y":5410},"width":130,"height":130,"text":"🧹","textFontFamily":"Inter","attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"EgJ-FYdIA2Mdkbtm7JZ9Y","type":"shape","kind":"rectangle","fillColor":"#b39cdb","position":{"x":10338,"y":5378},"width":140,"height":140,"text":"💡","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"dikSLrdU5Z4reJ56l1Kg4","type":"shape","kind":"rectangle","fillColor":"#b39cdb","position":{"x":10350,"y":5390},"width":140,"height":140,"text":"💡","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"jsawdNqDl4JsO4CTjLzqi","type":"shape","kind":"rectangle","fillColor":"#4caf50","position":{"x":8680,"y":5580},"width":400,"height":70,"text":"🧪 Cauldron","textFontFamily":"Inter","textSize":32,"textBold":true,"textColor":"#ffffff","attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"hzuXf5MhCFSa9Lvnu7bBq","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":8680,"y":5660},"width":400,"height":160,"text":"What do we brew next?\nWho? By when?","textFontFamily":"Inter","textSize":24,"textBold":true,"textAlignment":"center","textColor":"#000000","attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"y0mXpYtNCNRsa6aVoaupW","type":"shape","kind":"rectangle","fillColor":"#d2ebd3","position":{"x":9100,"y":5580},"width":1420,"height":240,"text":"","textFontFamily":"Inter","borderRadius":12,"attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"zorLXcCyt-sw_AtftTDKS","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10348,"y":5658},"width":120,"height":120,"text":"📜","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"NStVIfszufLmuQoQobZga","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10360,"y":5670},"width":120,"height":120,"text":"📜","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"NHxhfOBwXGLs_n2UuaLhT"},{"id":"CMXPRDx9HL72XPkE79s_P","type":"frame","position":{"x":10680,"y":4770},"width":1800,"height":1260,"attachedElements":["U8k4dUeW3MNLAl19HTNDG","FKbUM0-btbFNT4KIfYSHD"]},{"id":"U8k4dUeW3MNLAl19HTNDG","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Facilitation guide","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"CMXPRDx9HL72XPkE79s_P"},{"id":"FKbUM0-btbFNT4KIfYSHD","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 Halloween Retro: How it works in 5 steps\n\n🎯 Purpose: A spooky retrospective: what was sweet, what is rotten, which ideas should take off, and what do we brew next?\n\n1. Set the stage (5 min)\nAction: Write the period at the top. Quick round: which Halloween character are you today?\nRule: Open, respectful, no blame.\n\n2. Collect (10 min, silent)\nAction: Everyone copies cards from the stacks: chocolate bars 🍫 into the good pumpkin, rotten tomatoes 🍅 into the rotten pumpkin, ideas 💡 onto the witch’s broom.\nRule: One thought per card.\n\n3. Present and cluster (15 min)\nAction: Each person briefly presents their cards. Group similar cards.\n\n4. Prioritise (5 min)\nAction: Dot-vote the tomatoes and ideas, e.g. 3 dots each.\n\n5. Brew (15 min)\nAction: For the top topics, put recipe cards 📜 into the cauldron: what, who, by when?\nGoal: 1–3 actions that are actually done before the next retro.\n\n🛠️ Your role as facilitator\nSpook master: Keep it fun without losing the serious topics.\nTimekeeper: Save enough time for the cauldron.\nFollow-up: Start the next retro by looking into the cauldron.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"CMXPRDx9HL72XPkE79s_P"}]}]}}