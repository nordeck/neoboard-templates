{"version":"net.nordeck.whiteboard@v2","whiteboard":{"slides":[{"elements":[{"id":"WxGswdF5QV65COZ5YYeJO","type":"frame","position":{"x":8640,"y":4860},"width":1920,"height":1080,"attachedElements":["wi6e7Hd62RPqQqRILvwv-"]},{"id":"zsTcLCn4KewcTpa66vUua","type":"frame","position":{"x":10680,"y":4860},"width":1800,"height":1080,"attachedElements":["PWXBABxLV2PmxD_pasFmZ","7M9laThbjG_rSVGrBLelv"]},{"id":"wi6e7Hd62RPqQqRILvwv-","fillColor":"#673ab7","height":160,"position":{"x":8693.3935546875,"y":4913.31201171875},"type":"shape","kind":"rectangle","width":300,"text":"Probieren Sie selbst:","textColor":"#ffffff","textFontFamily":"Chewy","stickyNote":true,"textSize":48,"attachedFrame":"WxGswdF5QV65COZ5YYeJO","textBold":true,"rotation":347},{"id":"PWXBABxLV2PmxD_pasFmZ","type":"shape","kind":"rectangle","position":{"x":10720,"y":4860},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zsTcLCn4KewcTpa66vUua","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"7M9laThbjG_rSVGrBLelv","type":"shape","kind":"rectangle","position":{"x":10740,"y":5030},"width":1680,"height":880,"fillColor":"transparent","text":"🚀 Probieren Sie selbst: Der Ablauf in 4 Schritten\n\n🎯 Wofür: Ein geschützter Ort, um die Werkzeuge kennenzulernen, bevor es ernst wird.\n\n1. Haftnotiz anlegen (2 Min.)\nAktion: Erstellen Sie eine Haftnotiz und schreiben Sie Ihren Namen darauf.\n\n2. Formen und Pfeile (3 Min.)\nAktion: Zeichnen Sie ein Rechteck und einen Kreis und verbinden Sie beide mit einem Pfeil.\n\n3. Gestalten (3 Min.)\nAktion: Ändern Sie Farbe, Schriftgröße und Ausrichtung.\n\n4. Gemeinsam arbeiten (5 Min.)\nAktion: Verschieben Sie gemeinsam Karten und beobachten Sie, wie Änderungen bei allen sofort erscheinen.\n\n🛠️ Ihre Rolle als Moderator\nMutmacher: Fehler sind hier ausdrücklich erlaubt.\nHelfer: Gehen Sie die Schritte einmal gemeinsam durch.\nAufräumer: Leeren Sie den Rahmen vor der nächsten Gruppe.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zsTcLCn4KewcTpa66vUua","textSize":26,"textColor":"#000000"}]}]}}