],"strokeColor":"#9e9e9e","id":"LgsWwC_y0p9wb_fXBNSGl","attachedFrame":"QpJKf61fHwYTysDNizbHu"},{"position":{"x":8640,"y":5320},"type":"path","kind":"line","points":[{"x":0,"y":0},{"x":1920,"y":0}],"strokeColor":"#9e9e9e","id":"03rjqjVV9TiAVNsUUbQVl","attachedFrame":"QpJKf61fHwYTysDNizbHu"},{"id":"SAjI4HU8vXnSveaw9UjAY","fillColor":"transparent","height":60,"position":{"x":8560,"y":5720},"type":"shape","kind":"rectangle","width":280,"text":"SOFORT","textFontFamily":"Abel","textSize":32,"attachedFrame":"QpJKf61fHwYTysDNizbHu","rotation":270,"textBold":true},{"id":"ZEKeyO4EpzptfzN-2j0Cc","fillColor":"transparent","height":60,"position":{"x":8560,"y":5440},"type":"shape","kind":"rectangle","width":280,"text":"IM NÄCHSTEN JAHR","textFontFamily":"Abel","textSize":32,"attachedFrame":"QpJKf61fHwYTysDNizbHu","rotation":270,"textBold":true},{"id":"U41nv93J5FJJ54zAQkUfT","fillColor":"transparent","height":60,"position":{"x":8560,"y":5140},"type":"shape","kind":"rectangle","width":280,"text":"EIN TRÄUMCHEN","textFontFamily":"Abel","textSize":32,"attachedFrame":"QpJKf61fHwYTysDNizbHu","rotation":270,"textBold":true},{"id":"Ui3LdvKtruec5Xr7iqB61","type":"shape","kind":"rectangle","position":{"x":10720,"y":4860},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"YIzcODxvku9toKPtXwj1y","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"9KSfCEmFvL7QGUOvVKyqS","type":"shape","kind":"rectangle","position":{"x":10740,"y":5030},"width":1680,"height":930,"fillColor":"transparent","text":"🚀 Prioritäten-Pyramide: Der Ablauf in 4 Schritten\n\n🎯 Wofür: Wünsche und Ideen realistisch einordnen und klären, was sofort angegangen wird.\n\n1. Wünsche sammeln (5–10 Min.)\nAktion: Jeder notiert Vorhaben und Wünsche auf Karten, gern auch Ergebnisse aus „Wo stehen wir?\".\n\n2. Einordnen (10 Min.)\nAktion: Legen Sie jede Karte auf eine Ebene:\nSOFORT – machbar mit vorhandenen Mitteln.\nIM NÄCHSTEN JAHR – braucht Vorbereitung oder Budget.\nEIN TRÄUMCHEN – Vision, heute nicht planbar.\nRegel: Die Basis ist breit, die Spitze schmal. Zu viele Karten oben? Neu verhandeln.\n\n3. Schärfen (5–10 Min.)\nAktion: Prüfen Sie die Ebene SOFORT: Ist das wirklich sofort umsetzbar?\n\n4. Verbindlich machen (5–10 Min.)\nAktion: Geben Sie jeder Sofort-Karte eine verantwortliche Person und einen Termin.\nZiel: Eine kurze, verbindliche To-do-Liste und ein Speicher für Visionen.\n\n🛠️ Ihre Rolle als Moderator\nRealist: Fragen Sie nach Ressourcen, bevor etwas auf SOFORT landet.\nVisionshüter: Würdigen Sie Träumchen, sie zeigen die Richtung.\nAbschließer: Leiten Sie zu Aufgabenverteilung und Folgetermin über.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"YIzcODxvku9toKPtXwj1y","textSize":24,"textColor":"#000000"}]}]}}