"x":10140,"y":5510},"text":"End of life","attachedFrame":"g6psBLe1EDh1E2jYo14XO","textSize":32,"textBold":true},{"id":"MP8mWgYcpuuvSXW78Bf_t","position":{"x":8700,"y":5550},"type":"path","kind":"line","strokeColor":"#607d8b","points":[{"x":0,"y":0},{"x":1400,"y":0}],"attachedFrame":"g6psBLe1EDh1E2jYo14XO"},{"id":"-PfZveNgMvegXSc1j10uj","fillColor":"transparent","height":240,"position":{"x":8700,"y":5710},"type":"shape","kind":"rectangle","width":280,"text":"- Tasks\n- Owners\n- Risks\n- Dependencies","attachedFrame":"g6psBLe1EDh1E2jYo14XO","textAlignment":"left"},{"id":"AQ0nyEOM0KzjLmz-oq18V","textSize":24,"fillColor":"transparent","height":120,"position":{"x":8680,"y":5070},"type":"shape","kind":"rectangle","width":1840,"text":"Goal: What should the project achieve? · Scope: What is included and what is not? · End date: When is the project finished?","attachedFrame":"g6psBLe1EDh1E2jYo14XO"},{"id":"mmDQaJW2pSFkzwh0HLEPV","textSize":32,"textBold":true,"fillColor":"#00bcd4","height":80,"type":"shape","kind":"rectangle","width":280,"position":{"x":9700,"y":5390},"text":"Milestone F","attachedFrame":"g6psBLe1EDh1E2jYo14XO"},{"id":"8MlrC1ifLMDQA1pBmixon","fillColor":"#d7dee2","height":140,"position":{"x":8640,"y":4770},"type":"shape","kind":"rectangle","width":60,"text":"","textColor":"#8e3013","textFontFamily":"Inter","attachedFrame":"g6psBLe1EDh1E2jYo14XO","textSize":64},{"id":"vuIIIxREe8gaDATkkdhEd","fillColor":"#d7dee2","height":140,"position":{"x":8700,"y":4770},"type":"shape","kind":"rectangle","width":1860,"text":"Project Timeline","textSize":64,"textBold":true,"textAlignment":"left","attachedFrame":"g6psBLe1EDh1E2jYo14XO"},{"id":"si5wEjlSDV8bB5EgMxHTS","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Facilitation guide","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"nK5etKMA3IsfGy58xzeEU","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"zX9pdPVZrc_5CQtG9BtrT","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1060,"fillColor":"transparent","text":"🚀 Project Timeline: How it works in 4 steps\n\n🎯 Purpose: Plan a project along its milestones and make dependencies visible.\n\n1. Describe the project (5 min)\nAction: Replace the placeholder text with goal, scope and end date.\n\n2. Set milestones (15 min)\nAction: Rename Milestones A–F with real results and dates.\nRule: A milestone is a result, not an activity (\"Pilot live\", not \"Testing\").\n\n3. Add details (15 min)\nAction: Use the list below a milestone for tasks, owners and risks.\n\n4. Check and agree (10 min)\nAction: Walk the timeline from left to right: is it realistic? What depends on what?\nGoal: A timeline everyone commits to.\n\n🛠️ Your role as facilitator\nReality check: Ask for buffers between milestones.\nClarifier: Turn vague dates into concrete ones.\nKeeper: Revisit the board in each status meeting.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"nK5etKMA3IsfGy58xzeEU","textSize":30,"textColor":"#000000"}]}]}}