NzEY1","type":"shape","kind":"rectangle","fillColor":"#ffe5bf","position":{"x":10075,"y":5220},"width":445,"height":600,"text":"Ergebnisse der ganzen Gruppe","textFontFamily":"Inter","textSize":26,"textColor":"#8e5500","attachedFrame":"oOxMbFVhZINMtCRD2k9vg"},{"id":"NiP0Ps81wrHHWZoY8qQGY","type":"frame","position":{"x":10680,"y":4770},"width":1800,"height":1260,"attachedElements":["Q-atheNONvk_r3tbRvVat","7mgnzhmJDcoLtL4kTsIpu"]},{"id":"Q-atheNONvk_r3tbRvVat","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Methodenbeschreibung","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"NiP0Ps81wrHHWZoY8qQGY"},{"id":"7mgnzhmJDcoLtL4kTsIpu","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 1-2-4-Alle: Der Ablauf in 4 Schritten\n\n🎯 Wofür: Alle Stimmen einbeziehen und in kurzer Zeit von vielen Einzelideen zu wenigen starken Ideen kommen.\n\n1. Allein (1 Min.)\nAktion: Stellen Sie die Leitfrage. Jede Person denkt still nach und notiert Ideen in ihrem Feld.\n\n2. Zu zweit (2 Min.)\nAktion: Paare tauschen ihre Ideen aus und entwickeln sie im Paar-Feld weiter.\n\n3. Zu viert (4 Min.)\nAktion: Zwei Paare bilden eine Vierergruppe. Was ist ähnlich, was unterscheidet sich? Wählen Sie die stärkste Idee.\n\n4. Alle (5 Min.)\nAktion: Jede Gruppe stellt ihre wichtigste Idee vor und legt sie ins Ergebnisfeld.\nRegel: Nur neue Ideen nennen, Doppeltes überspringen.\n\n🛠️ Ihre Rolle als Moderation\nTaktgeber: Halten Sie die kurzen Zeiten konsequent ein.\nGruppengröße: Bei mehr als acht Personen den Rahmen duplizieren.\n\nNach „1-2-4-All“ von Henri Lipmanowicz und Keith McCandless, Liberating Structures (liberatingstructures.com, CC BY-SA 4.0). Eigene Beschreibung.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"NiP0Ps81wrHHWZoY8qQGY"}]}]}}