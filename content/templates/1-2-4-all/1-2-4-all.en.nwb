pe","kind":"rectangle","fillColor":"#bfe4e1","position":{"x":9145,"y":5676},"width":445,"height":142,"text":"Pair D","textFontFamily":"Inter","textSize":22,"textColor":"#00544c","attachedFrame":"EFcJj32BdfjjaFSYg6ogf"},{"id":"2rpcgiVr_JQL4rsxs05O-","type":"shape","kind":"rectangle","fillColor":"#8bc34a","position":{"x":9610,"y":5055},"width":445,"height":80,"text":"4 · Foursomes · 4 min","textFontFamily":"Inter","textSize":30,"textBold":true,"textColor":"#000000","attachedFrame":"EFcJj32BdfjjaFSYg6ogf"},{"id":"mPzrG4rKmrxXhs6WPFc18","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":9610,"y":5140},"width":445,"height":70,"text":"Find what is similar and what differs.","textFontFamily":"Inter","textSize":22,"textAlignment":"center","textColor":"#353535","attachedFrame":"EFcJj32BdfjjaFSYg6ogf"},{"id":"GT-Pm0Cc24b-K0GHviArg","type":"shape","kind":"rectangle","fillColor":"#e2f0d1","position":{"x":9610,"y":5220},"width":445,"height":295,"text":"Group A","textFontFamily":"Inter","textSize":24,"textColor":"#4d6d29","attachedFrame":"EFcJj32BdfjjaFSYg6ogf"},{"id":"SdlOUZG8WaNkD48LLRSnq","type":"shape","kind":"rectangle","fillColor":"#e2f0d1","position":{"x":9610,"y":5525},"width":445,"height":295,"text":"Group B","textFontFamily":"Inter","textSize":24,"textColor":"#4d6d29","attachedFrame":"EFcJj32BdfjjaFSYg6ogf"},{"id":"hhav6B1ftaQH7Qn5d-_q-","type":"shape","kind":"rectangle","fillColor":"#ff9800","position":{"x":10075,"y":5055},"width":445,"height":80,"text":"All · 5 min","textFontFamily":"Inter","textSize":30,"textBold":true,"textColor":"#000000","attachedFrame":"EFcJj32BdfjjaFSYg6ogf"},{"id":"Y4jqJyzsfjZUkwMLCzlID","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10075,"y":5140},"width":445,"height":70,"text":"Each group shares its most important idea.","textFontFamily":"Inter","textSize":22,"textAlignment":"center","textColor":"#353535","attachedFrame":"EFcJj32BdfjjaFSYg6ogf"},{"id":"bdaYbJMVd69Y1Eq59pQ6u","type":"shape","kind":"rectangle","fillColor":"#ffe5bf","position":{"x":10075,"y":5220},"width":445,"height":600,"text":"Results of the whole group","textFontFamily":"Inter","textSize":26,"textColor":"#8e5500","attachedFrame":"EFcJj32BdfjjaFSYg6ogf"},{"id":"2DgHxFdhivubOUyPxsvLm","type":"frame","position":{"x":10680,"y":4770},"width":1800,"height":1260,"attachedElements":["GHZ-PPLUyBnqNwOYuegUg","X1vVCcAJkP6Kj-F5RSXpH"]},{"id":"GHZ-PPLUyBnqNwOYuegUg","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Facilitation guide","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"2DgHxFdhivubOUyPxsvLm"},{"id":"X1vVCcAJkP6Kj-F5RSXpH","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 1-2-4-All: How it works in 4 steps\n\n🎯 Purpose: Include every voice and get from many individual ideas to a few strong ones in a short time.\n\n1. Alone (1 min)\nAction: Ask the question. Everyone reflects in silence and notes ideas in their own box.\n\n2. Pairs (2 min)\nAction: Pairs share their ideas and develop them further in their pair box.\n\n3. Foursomes (4 min)\nAction: Two pairs form a foursome. What is similar, what differs? Choose the strongest idea.\n\n4. All (5 min)\nAction: Each group presents its most important idea and places it in the results area.\nRule: Only share new ideas, skip duplicates.\n\n🛠️ Your role as facilitator\nPacemaker: Stick to the short time boxes.\nGroup size: With more than eight people, duplicate the frame.\n\nBased on \"1-2-4-All\" by Henri Lipmanowicz and Keith McCandless, Liberating Structures (liberatingstructures.com, CC BY-SA 4.0). Own description.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"2DgHxFdhivubOUyPxsvLm"}]}]}}