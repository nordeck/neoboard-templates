ition":{"x":10160,"y":5550},"type":"shape","kind":"rectangle","width":160,"text":"","attachedFrame":"Mm7Nb-wae-310O2Z9gZhu"},{"id":"xa6TWUcPzUOChTtgM-nPJ","fillColor":"#d7dee2","height":80,"position":{"x":10360,"y":5550},"type":"shape","kind":"rectangle","width":160,"text":"","attachedFrame":"Mm7Nb-wae-310O2Z9gZhu"},{"id":"aP8qLqvjOFntV5C4YENJi","fillColor":"#d7dee2","height":140,"position":{"x":8640,"y":4770},"type":"shape","kind":"rectangle","width":60,"text":"","textColor":"#8e3013","textFontFamily":"Inter","textSize":64,"attachedFrame":"Mm7Nb-wae-310O2Z9gZhu"},{"id":"6XABvXMSaZ3LlApdwfs5F","fillColor":"#d7dee2","height":140,"position":{"x":8700,"y":4770},"type":"shape","kind":"rectangle","width":1860,"text":"Kanban Board","textSize":64,"textBold":true,"textAlignment":"left","attachedFrame":"Mm7Nb-wae-310O2Z9gZhu"},{"id":"ZoaL7KWVw7oMYKA2n5a_a","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Facilitation guide","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"NLH1vgeTfZ4zUnPnUuIfq","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"oJQK2e-014fVfZOThrlnX","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1060,"fillColor":"transparent","text":"🚀 Kanban Board: How it works in 4 steps\n\n🎯 Purpose: Make work visible, limit work in progress and keep tasks flowing to Done.\n\n1. Fill the backlog (10 min)\nAction: Write every task on its own card and place it in \"To do\".\nRule: One task per card, phrased as an action (\"Update price list\").\n\n2. Agree on colours and limits (5 min)\nAction: Assign each card colour a meaning (e.g. feature, bug, admin).\nRule: Set a maximum number of cards for \"In Progress\" (e.g. 3 per person).\n\n3. Pull work (ongoing)\nAction: Whoever starts a task moves the card to \"In Progress\" and adds their name.\nRule: Only pull new work when the limit allows it.\n\n4. Finish and review (weekly)\nAction: Move finished cards to \"Done\" and look at what got stuck and why.\nGoal: Learn where the flow slows down.\n\n🛠️ Your role as facilitator\nFlow keeper: In short stand-ups, walk the board from right to left: what is almost done?\nLimit guard: Point out when \"In Progress\" overflows.\nHousekeeper: Archive old \"Done\" cards regularly.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"NLH1vgeTfZ4zUnPnUuIfq","textSize":28,"textColor":"#000000"}]}]}}