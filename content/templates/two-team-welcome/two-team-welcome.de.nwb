":"Abel","stickyNote":true,"id":"i9yYn07F2_ecBOYn4C0ek","attachedFrame":"8kSIwxGKMF669kqtffq_c"},{"fillColor":"#e6c9eb","height":160,"position":{"x":9060,"y":5820},"type":"shape","kind":"rectangle","width":300,"text":"","textColor":"#35464d","textFontFamily":"Abel","stickyNote":true,"id":"iWEbxDqMZS_9u26rDVEox","attachedFrame":"8kSIwxGKMF669kqtffq_c"},{"fillColor":"#cfd3ec","height":160,"position":{"x":9780,"y":5860},"type":"shape","kind":"rectangle","width":300,"text":"","textColor":"#35464d","textFontFamily":"Abel","stickyNote":true,"id":"qlYxf7BX0k4R2Rvy-APgv","attachedFrame":"8kSIwxGKMF669kqtffq_c"},{"fillColor":"#cfd3ec","height":160,"position":{"x":9820,"y":5820},"type":"shape","kind":"rectangle","width":300,"text":"","textColor":"#35464d","textFontFamily":"Abel","stickyNote":true,"id":"NycwGChkxAucOxlSguy-T","attachedFrame":"8kSIwxGKMF669kqtffq_c"},{"id":"mdTK7c1k7F-XK4NNe2tZD","fillColor":"#e6c9eb","height":160,"position":{"x":9100,"y":5220},"type":"shape","kind":"rectangle","width":300,"text":"Diskussion: Vernetzung auf welchen Ebenen?","textColor":"#392066","textFontFamily":"Chewy","stickyNote":true,"attachedFrame":"8kSIwxGKMF669kqtffq_c"},{"id":"NAtD7hFRro6vuqZ6Si0je","fillColor":"#cfd3ec","height":160,"position":{"x":9740,"y":5300},"type":"shape","kind":"rectangle","width":300,"text":"Next steps finden","textColor":"#232d65","textFontFamily":"Chewy","stickyNote":true,"attachedFrame":"8kSIwxGKMF669kqtffq_c"},{"id":"tleY-tggC0sQK35Iv8xNd","type":"image","width":427.875111564642,"height":639.0432491491337,"position":{"x":8660,"y":5140},"mxc":"mxc://nd-mmoura.ihp.dev.zendis.net/aILFpbUoZevOqTjogmFDGzLe","fileName":"stuhl_rosa.jpg","attachedFrame":"8kSIwxGKMF669kqtffq_c","rotation":356},{"id":"l5_XPdA7fqzCfvzxByLqc","type":"image","width":467.3393208837109,"height":623.1190945116145,"position":{"x":10040,"y":5160},"mxc":"mxc://nd-mmoura.ihp.dev.zendis.net/egJLDmIzpUmGQzbQSKOzjCCc","fileName":"stuhl_blaulila.png","attachedFrame":"8kSIwxGKMF669kqtffq_c","rotation":7},{"id":"nqFQLXJqtcAAbVPj_a5Pk","type":"shape","kind":"rectangle","position":{"x":10720,"y":4860},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"P6OPVBKsDK2GTHXnbZqxo","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"qNZS1BTXfUx3vYwLL5E6G","type":"shape","kind":"rectangle","position":{"x":10740,"y":5030},"width":1680,"height":880,"fillColor":"transparent","text":"🚀 Willkommen: Der Ablauf in 3 Schritten\n\n🎯 Wofür: Zwei Teams oder Organisationen lernen sich kennen und machen ihre Erwartungen an die Zusammenarbeit sichtbar.\n\n1. Platz nehmen (2 Min.)\nAktion: Ersetzen Sie „Team A\" und „Team B\" durch die echten Namen. Jedes Team nutzt die Kartenfarbe unter seinem Namen.\n\n2. Erwartungen sammeln (5–8 Min.)\nAktion: Jeder beantwortet die Leitfrage „Mit welchen Erwartungen seid Ihr heute hier?\" auf eigenen Karten und legt sie auf die Seite seines Teams.\nRegel: Eine Erwartung pro Karte.\n\n3. Gemeinsames finden (5–10 Min.)\nAktion: Beide Teams stellen ihre Karten kurz vor. Gemeinsame Themen wandern in die Mitte, z. B. „Vernetzung auf welchen Ebenen?\" oder „Next steps finden\".\nZiel: Eine geteilte Liste der Themen für das Treffen.\n\n🛠️ Ihre Rolle als Moderator\nGastgeber: Sorgen Sie dafür, dass beide Teams gleich viel Raum bekommen.\nÜbersetzer: Machen Sie unterschiedliche Begriffe für Gleiches sichtbar.\nSammler: Halten Sie offene Erwartungen fest, die heute nicht erfüllt werden.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"P6OPVBKsDK2GTHXnbZqxo","textSize":24,"textColor":"#000000"}]}],"files":[{"mxc":"mxc://nd-mmoura.ihp.dev.zendis.net/aILFpbUoZevOqTjogmFDGzLe","data":""},{"mxc":"mxc://nd-mmoura.ihp.dev.zendis.net/egJLDmIzpUmGQzbQSKOzjCCc","data":""}]}}