textSize":32,"textBold":true,"textAlignment":"left"},{"id":"AbBH80PHI-rdcUd8AJ2r-","fillColor":"transparent","height":40,"position":{"x":9600,"y":5830},"type":"shape","kind":"rectangle","width":200,"text":"Revenue Streams","attachedFrame":"Jlv8GE8EcuQvnlXw25qlH","textSize":32,"textBold":true,"textAlignment":"left"},{"id":"l8sA3uX1y6QmkDyeZ1bpr","fillColor":"transparent","height":40,"position":{"x":9600,"y":5910},"type":"shape","kind":"rectangle","width":200,"text":"Societal Benefits","attachedFrame":"Jlv8GE8EcuQvnlXw25qlH","textSize":32,"textBold":true,"textAlignment":"left"},{"id":"RrZfZICeiDhKhjOS2qsii","attachedFrame":"Jlv8GE8EcuQvnlXw25qlH","fillColor":"#d7dee2","height":140,"position":{"x":8640,"y":4770},"type":"shape","kind":"rectangle","width":60,"text":"","textColor":"#8e3013","textFontFamily":"Inter","textSize":64},{"id":"8Fnx8FHVX4xWZ_acnruCV","attachedFrame":"Jlv8GE8EcuQvnlXw25qlH","fillColor":"#d7dee2","height":140,"position":{"x":8700,"y":4770},"type":"shape","kind":"rectangle","width":1860,"text":"Business Model Canvas","textSize":64,"textBold":true,"textAlignment":"left"},{"id":"KN7Vj3LMt1DViLVWWR5oL","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Facilitation guide","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"D73rvN6mjSpR0nVsA02UC","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"z7DWDnDp5nYlxWJ_uiQ4D","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1080,"fillColor":"transparent","text":"🚀 Business Model Canvas: How it works in 5 steps\n\n🎯 Purpose: Describe, analyse or design a business model on one page, including its impact.\n\n1. Define the scope (5 min)\nAction: Agree on the product, service or initiative you map.\n\n2. Start with the customer (20 min)\nAction: Fill Customer Segments, then Value Propositions.\nRule: One assumption per card. Be specific: who exactly, what problem?\n\n3. Map delivery (20 min)\nAction: Fill Channels and Customer Relationships, then Revenue Streams.\n\n4. Map the engine (20 min)\nAction: Fill Key Activities, Key Resources and Key Partners, then Cost Structure.\n\n5. Check the impact (15 min)\nAction: Add Environmental Costs and Societal Benefits.\nGoal: Mark the riskiest assumptions and decide how to test them.\n\n🛠️ Your role as facilitator\nOrder keeper: Follow the sequence; it prevents jumping to costs too early.\nChallenger: Ask \"How do we know?\" for every card.\nSynthesiser: End with the 3 biggest risks and next tests.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"D73rvN6mjSpR0nVsA02UC","textSize":28,"textColor":"#000000"}]}]}}