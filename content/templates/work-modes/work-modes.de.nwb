75,"height":92.00799056195775,"position":{"x":9320,"y":5160},"mxc":"mxc://neotoolsuite.demo.nordeck.io/rxxnHDthzluGlxrRRuiplGWv","fileName":"travel_luggage_and_bags_80dp_000000_FILL0_wght400_GRAD0_opsz48.svg","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"oIHTLPGmGJ4zt_fMRUha7","type":"image","width":92.00799056195775,"height":92.00799056195775,"position":{"x":8900,"y":5160},"mxc":"mxc://neotoolsuite.demo.nordeck.io/HfyUcBDjJHUHjkdbffndVBcp","fileName":"apartment_80dp_000000_FILL0_wght400_GRAD0_opsz48.svg","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"HC23r0Zr0pbUCvtv2Hw0h","fillColor":"#e6e6e6","height":120,"position":{"x":8700,"y":5540},"type":"shape","kind":"triangle","width":1800,"text":"","textFontFamily":"Inter","rotation":180,"attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"fillColor":"#d9cded","height":100,"position":{"x":8640,"y":4880},"type":"shape","kind":"rectangle","width":1920.0000000000005,"text":"Zusammenarbeit unabhängig von Zeit und Ort","textFontFamily":"Inter","textSize":64,"textBold":true,"textColor":"#000000","id":"d3-Eg6qwqv1IK_WY4eeGi","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"qkbnpWJNh8Kba7CKrtJve","type":"shape","kind":"rectangle","position":{"x":10720,"y":4860},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"lYzBgQGiGcjAos3cHuwD7","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"1V0IfSxRFPexUN6rDamiI","type":"shape","kind":"rectangle","position":{"x":10740,"y":5030},"width":1680,"height":880,"fillColor":"transparent","text":"🚀 Arbeitsorte & -modi: Der Ablauf in 3 Schritten\n\n🎯 Wofür: Klären, wo und wie ein Team zusammenarbeitet, und Vereinbarungen für hybride Zusammenarbeit treffen.\n\n1. Verorten (5 Min.)\nAktion: Jeder setzt einen Punkt oder eine Namenskarte unter die Orte, an denen er typischerweise arbeitet: Büro, unterwegs, remote, Unterricht.\n\n2. Modi zuordnen (5–10 Min.)\nAktion: Sammeln Sie Aufgaben auf Karten und legen Sie sie in die Zeile synchron (gleichzeitig) oder asynchron (zeitversetzt).\nRegel: Fragen Sie: Muss das wirklich gleichzeitig passieren?\n\n3. Vereinbaren (5–15 Min.)\nAktion: Leiten Sie 2–3 Vereinbarungen ab, z. B. Kernzeiten, Antwortzeiten oder feste Austauschformate.\n\n🛠️ Ihre Rolle als Moderator\nNeugierige: Fragen Sie nach Gründen, nicht nach Rechtfertigungen.\nAusgleicher: Achten Sie darauf, dass Remote-Arbeitende gleich gut eingebunden sind.\nFesthalter: Dokumentieren Sie die Vereinbarungen sichtbar auf dem Board.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"lYzBgQGiGcjAos3cHuwD7","textSize":26,"textColor":"#000000"}]}],"files":[{"mxc":"mxc://neotoolsuite.demo.nordeck.io/NSZUHsxYvKuFnrsrcHYalStm","data":""},{"mxc":"mxc://neotoolsuite.demo.nordeck.io/JBrWfzhNMYSGbZYShUpPXSIH","data":""},{"mxc":"mxc://neotoolsuite.demo.nordeck.io/MKlkNSNtisDjZIsPcFwiJSpe","data":""},{"mxc":"mxc://neotoolsuite.demo.nordeck.io/qxuqFMImeBSTZnCwcDfIAGXd","data":""},{"mxc":"mxc://neotoolsuite.demo.nordeck.io/rxxnHDthzluGlxrRRuiplGWv","data":""},{"mxc":"mxc://neotoolsuite.demo.nordeck.io/HfyUcBDjJHUHjkdbffndVBcp","data":""}]}}