ow","width":60,"text":"","textFontFamily":"Inter","attachedFrame":"ZLW_14y4aVi5KH61Yxbb3"},{"id":"6uWakz1Q9lLBk7c0TTjV6","fillColor":"#d7dee2","height":840,"position":{"x":8680,"y":4990},"type":"shape","kind":"rectangle","width":280,"text":"","attachedFrame":"ZLW_14y4aVi5KH61Yxbb3"},{"id":"MYwHOyvuKc0ipq0CaDf-D","fillColor":"transparent","height":100,"position":{"x":8680,"y":4990},"type":"shape","kind":"rectangle","width":280,"text":"Themen-sammlung","attachedFrame":"ZLW_14y4aVi5KH61Yxbb3","textSize":32,"textBold":true},{"id":"U3BxWT7YPEr3hNjx_ztC4","fillColor":"#ffffff","height":40,"position":{"x":8780,"y":5810},"type":"shape","kind":"triangle","width":80,"text":"","textFontFamily":"Inter","attachedFrame":"ZLW_14y4aVi5KH61Yxbb3"},{"id":"xkBytohMeaXSbESMtYbtC","fillColor":"#cddc39","height":68.57142857142857,"position":{"x":8700,"y":5850},"type":"shape","kind":"ellipse","width":240,"text":"","attachedFrame":"ZLW_14y4aVi5KH61Yxbb3","textSize":16},{"id":"COpsWFWxz25CQBqpS3_CU","fillColor":"#ffeb3b","height":68.57142857142857,"position":{"x":8700,"y":5890},"type":"shape","kind":"ellipse","width":240,"text":"","attachedFrame":"ZLW_14y4aVi5KH61Yxbb3","textSize":16},{"id":"L2GKpDcTG6YlUo9_zwd_c","fillColor":"#00bcd4","height":68.57142857142857,"position":{"x":8700,"y":5930},"type":"shape","kind":"ellipse","width":240,"text":"Thema hinzufügen","attachedFrame":"ZLW_14y4aVi5KH61Yxbb3","textItalic":true,"textSize":16},{"id":"BBRhwGIhHA0zffsPstAfa","fillColor":"#e91e63","height":120,"position":{"x":10380,"y":5750},"type":"shape","kind":"rectangle","width":140,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"ZLW_14y4aVi5KH61Yxbb3"},{"id":"a3JxINxQ-wwRTn_BT6XtV","fillColor":"#e91e63","height":120,"position":{"x":10360,"y":5770},"type":"shape","kind":"rectangle","width":140,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"ZLW_14y4aVi5KH61Yxbb3"},{"id":"dg-ksc0ZP87M8DKHynPPt","fillColor":"#e91e63","height":120,"position":{"x":10340,"y":5790},"type":"shape","kind":"rectangle","width":140,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"ZLW_14y4aVi5KH61Yxbb3"},{"id":"H3z-PCBfuMDJY7g0YW0Dy","fillColor":"#e91e63","height":120,"position":{"x":10320,"y":5810},"type":"shape","kind":"rectangle","width":140,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"ZLW_14y4aVi5KH61Yxbb3"},{"id":"NIgIWYYE6ZBDvnM2Ezq5z","fillColor":"#ffffff","height":40,"position":{"x":10250.68359375,"y":5850},"type":"shape","kind":"triangle","width":80,"text":"","textFontFamily":"Inter","attachedFrame":"ZLW_14y4aVi5KH61Yxbb3","rotation":270},{"id":"8x7pa7kXwFih9pu4yTMU-","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"z1Zw8buxLTQSYuPeGZcrd","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"GzKno6a53d3cjd2fJfrfE","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1074,"fillColor":"transparent","text":"🚀 Lean Coffee: Der Ablauf in 4 Schritten\n\n1. Themen sammeln (3–5 Min.)\nAktion: Jeder Teilnehmer schreibt seine Themenwünsche auf jeweils eine Post-it-Notiz (digital oder analog).\nRegel: Ein Thema pro Karte. Kurz und verständlich.\nZiel: Alle Karten im Themenpool sammeln.\n\n2. Priorisieren per Dot-Voting (3 Min.)\nAktion: Jeder Teilnehmer erhält eine feste Anzahl an Stimmen (z. B. 3 Punkte).\nRegel: Man darf seine Punkte frei verteilen – auch alle auf ein einziges Thema.\nZiel: Die Karten mit den meisten Stimmen werden von oben nach unten in die Spalte \"Auswahl\" sortiert. Das ist Ihre finale Agenda.\n\n3. Diskutieren mit Timeboxing (Die Kernphase)\nAktion: Ziehen Sie das oberste Thema in \"Diskussion\" und starten Sie einen Timer auf 5 Minuten.\nDer Pitch: Der Einreicher des Themas erklärt kurz (ca. 30–60 Sekunden), worum es geht. Danach ist die Diskussion für alle eröffnet.\n\n4. Die Verlängerung (Römische Abstimmung)\nSobald die 5 Minuten um sind, entscheidet die Gruppe per Handzeichen über die verbleibende Zeit:\n👍 Daumen hoch: Das Thema ist noch heiß. Wir verlängern um weitere 2–3 Minuten (nur einmal pro Thema empfohlen).\n👎 Daumen runter: Das Thema ist durch. Karte zu \"Erledigt\" schieben und das nächste Thema starten.\n✊ Daumen zur Seite: Mir egal / Enthaltung.\n\n🛠️ Ihre Rolle als Moderator\nStrenger Zeitwächter: Lassen Sie den Timer für alle sichtbar laufen. Unterbrechen Sie konsequent, wenn die Zeit abläuft, um das Voting einzufordern.\nVisualisierer: Sorgen Sie dafür, dass die Karten synchron zum Gesprächsstand wandern.\nFokus-Hüter: Schweift die Diskussion ab, erinnern Sie freundlich an das Kern-Thema auf dem Post-it.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"z1Zw8buxLTQSYuPeGZcrd","textSize":24,"textColor":"#000000"}]}]}}