or":"#e6e6e6","height":840,"position":{"x":8680,"y":4990},"type":"shape","kind":"rectangle","width":280,"text":"","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4"},{"id":"xQmlMa02NMbXv0F7kh7aR","fillColor":"transparent","height":80,"position":{"x":8680,"y":4990},"type":"shape","kind":"rectangle","width":280,"text":"Topic Collection","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4","textSize":32,"textBold":true},{"id":"j6VTB0vcZ_qQd3dMdCE_b","fillColor":"#ffffff","height":40,"position":{"x":8780,"y":5810},"type":"shape","kind":"triangle","width":80,"text":"","textFontFamily":"Inter","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4"},{"id":"DwK695zTQ4V1DD87TEwQs","fillColor":"#cddc39","height":68.57142857142857,"position":{"x":8700,"y":5850},"type":"shape","kind":"ellipse","width":240,"text":"","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4"},{"id":"8Rxyee_PFhNjPfjwfiZ7X","fillColor":"#ffeb3b","height":68.57142857142857,"position":{"x":8700,"y":5890},"type":"shape","kind":"ellipse","width":240,"text":"","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4"},{"id":"neQEtv0SabMg2l8KVvg5U","fillColor":"#00bcd4","height":68.57142857142857,"position":{"x":8700,"y":5930},"type":"shape","kind":"ellipse","width":240,"text":"add topic to topic collection","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4","textItalic":true,"textSize":16},{"id":"JJYqc36D9IZqFKbgTBH_2","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Facilitation guide","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zy-PzjyQUq7cU7-ANasMX","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"Yk1i1qnLFwUONcc3nYU2U","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1074,"fillColor":"transparent","text":"🚀 Lean Coffee: How it works in 4 steps\n\n🎯 Purpose: A meeting without a fixed agenda. The group decides what matters most.\n\n1. Collect topics (3–5 min)\nAction: Everyone writes topic ideas on cards (add topic to topic collection).\nRule: One topic per card. Short and clear.\nGoal: All cards in \"Topic Collection\".\n\n2. Prioritise with dot voting (3 min)\nAction: Everyone gets a fixed number of votes (e.g. 3 dots).\nRule: Votes can be distributed freely, even all on one topic.\nGoal: Sort the top cards into \"Topic Selection\". This is your agenda.\n\n3. Discuss with timeboxing (core phase)\nAction: Move the top topic to \"Topic Discussion\" and start a 5-minute timer.\nThe pitch: The topic owner explains it in 30–60 seconds, then everyone joins in.\n\n4. Extend or close (Roman vote)\nWhen time is up, the group votes by hand signal:\n👍 Thumbs up: Still hot. Extend by 2–3 minutes (once per topic).\n👎 Thumbs down: Done. Move the card to \"Done Topics\", start the next one.\n✊ Sideways: Don't mind / abstain.\nNote follow-ups in \"Action Items\".\n\n🛠️ Your role as facilitator\nTimekeeper: Keep the timer visible and stop consistently.\nVisualiser: Move cards in sync with the conversation.\nFocus keeper: Gently bring the group back to the card's topic.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zy-PzjyQUq7cU7-ANasMX","textSize":24,"textColor":"#000000"}]}]}}