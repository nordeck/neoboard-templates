,"kind":"rectangle","fillColor":"#ffe083","position":{"x":9712,"y":5640},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"Z-l71sW6CEqfaovLzpPZj"},{"id":"ihJvKA7Ekju-EpfgH-s92","type":"shape","kind":"rectangle","fillColor":"#ffe083","position":{"x":9700,"y":5628},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"Z-l71sW6CEqfaovLzpPZj"},{"id":"3xWixnSGQps4IHpECoBwB","type":"path","kind":"line","position":{"x":9898,"y":5070},"points":[{"x":0,"y":0},{"x":32,"y":0}],"strokeColor":"#35464d","endMarker":"arrow-head-line","attachedFrame":"Z-l71sW6CEqfaovLzpPZj"},{"id":"TIQ5LsQpdyJ3NfDRoHxG1","type":"shape","kind":"rectangle","fillColor":"#4caf50","position":{"x":9936,"y":5030},"width":584,"height":80,"text":"3 · Stoppen","textFontFamily":"Inter","textSize":34,"textBold":true,"textColor":"#ffffff","attachedFrame":"Z-l71sW6CEqfaovLzpPZj"},{"id":"QK2IPlr1W0UMgmzUSUH2s","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":9936,"y":5115},"width":584,"height":90,"text":"Wie hören wir damit auf? Was ist der erste Schritt?","textFontFamily":"Inter","textSize":24,"textBold":true,"textAlignment":"center","textColor":"#000000","attachedFrame":"Z-l71sW6CEqfaovLzpPZj"},{"id":"YdbqY2dIU6BDB4PgRwcTG","type":"shape","kind":"rectangle","fillColor":"#d2ebd3","position":{"x":9936,"y":5215},"width":584,"height":605,"text":"","textFontFamily":"Inter","borderRadius":12,"attachedFrame":"Z-l71sW6CEqfaovLzpPZj"},{"id":"ncVB_F92yq2ui5MnO9IPs","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10340,"y":5640},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"Z-l71sW6CEqfaovLzpPZj"},{"id":"3DE08iPWoyhv8NfEruEJd","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10328,"y":5628},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"Z-l71sW6CEqfaovLzpPZj"},{"id":"eN2DWn76Iknvo4fYO2SE5","type":"frame","position":{"x":10680,"y":4770},"width":1800,"height":1260,"attachedElements":["ree5Ee6iKu-_vBlLWXVSF","K-biqH5Vm-qO_9-YORpUj"]},{"id":"ree5Ee6iKu-_vBlLWXVSF","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Methodenbeschreibung","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"eN2DWn76Iknvo4fYO2SE5"},{"id":"K-biqH5Vm-qO_9-YORpUj","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 TRIZ: Der Ablauf in 3 Schritten\n\n🎯 Wofür: Mit einem Augenzwinkern aufdecken, was den Erfolg heute schon bremst, und es gezielt beenden.\n\n1. Maximal scheitern (10 Min.)\nAktion: Tragen Sie das Ziel oben ein. Kleingruppen sammeln alles, was das Ziel garantiert scheitern ließe.\nRegel: Übertreiben ist erwünscht. Je absurder, desto besser.\n\n2. Ehrlich prüfen (10 Min.)\nAktion: Gehen Sie die Liste durch: Was davon passiert heute schon, auch nur ein bisschen? Diese Notizen wandern in Spalte 2.\nTipp: Hier wird es ernst. Sorgen Sie für eine offene, wertschätzende Atmosphäre.\n\n3. Stoppen (10 Min.)\nAktion: Legen Sie für jede Notiz in Spalte 2 fest, wie Sie damit aufhören, und den ersten konkreten Schritt.\nZiel: Wenige, klare Stopp-Vereinbarungen mit verantwortlicher Person.\n\n🛠️ Ihre Rolle als Moderation\nSpielleitung: Laden Sie in Schritt 1 ausdrücklich zum Übertreiben ein.\nBrückenbauer: Führen Sie behutsam vom Lachen zur ehrlichen Selbstprüfung.\n\nNach „Making Space with TRIZ“ von Henri Lipmanowicz und Keith McCandless, Liberating Structures (liberatingstructures.com, CC BY-SA 4.0). Eigene Beschreibung.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"eN2DWn76Iknvo4fYO2SE5"}]}]}}