,"kind":"rectangle","fillColor":"#ffe083","position":{"x":9712,"y":5640},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"tUO8DR9CtiHCz79CdGFdh"},{"id":"K6qjV1nsH7VablvKMHQTR","type":"shape","kind":"rectangle","fillColor":"#ffe083","position":{"x":9700,"y":5628},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"tUO8DR9CtiHCz79CdGFdh"},{"id":"5QRCOj5QJvyqMbGWFzk4U","type":"path","kind":"line","position":{"x":9898,"y":5070},"points":[{"x":0,"y":0},{"x":32,"y":0}],"strokeColor":"#35464d","endMarker":"arrow-head-line","attachedFrame":"tUO8DR9CtiHCz79CdGFdh"},{"id":"b7fR8Phzdr9TL0WsyOHiM","type":"shape","kind":"rectangle","fillColor":"#4caf50","position":{"x":9936,"y":5030},"width":584,"height":80,"text":"3 · Stoppen","textFontFamily":"Inter","textSize":34,"textBold":true,"textColor":"#ffffff","attachedFrame":"tUO8DR9CtiHCz79CdGFdh"},{"id":"BaWKQbVXMd4p4gVK83g8g","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":9936,"y":5115},"width":584,"height":90,"text":"Wie hören wir damit auf? Was ist der erste Schritt?","textFontFamily":"Inter","textSize":24,"textBold":true,"textAlignment":"center","textColor":"#000000","attachedFrame":"tUO8DR9CtiHCz79CdGFdh"},{"id":"W7i4pfwCvYuAK5k2mYVsf","type":"shape","kind":"rectangle","fillColor":"#d2ebd3","position":{"x":9936,"y":5215},"width":584,"height":605,"text":"","textFontFamily":"Inter","borderRadius":12,"attachedFrame":"tUO8DR9CtiHCz79CdGFdh"},{"id":"-Ha8EevUtGh0Kio3XbIoV","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10340,"y":5640},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"tUO8DR9CtiHCz79CdGFdh"},{"id":"0LyZBfY95LGjr_vp8cmTC","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10328,"y":5628},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"tUO8DR9CtiHCz79CdGFdh"},{"id":"Zo2kyaN0nFS7-dloU-xxN","type":"frame","position":{"x":10680,"y":4770},"width":1800,"height":1260,"attachedElements":["kBiKPy_BzFBztAfshGsdW","_Jk7DPkX0M85gsaZDJwez"]},{"id":"kBiKPy_BzFBztAfshGsdW","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Methodenbeschreibung","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"Zo2kyaN0nFS7-dloU-xxN"},{"id":"_Jk7DPkX0M85gsaZDJwez","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 TRIZ: Der Ablauf in 3 Schritten\n\n🎯 Wofür: Mit einem Augenzwinkern aufdecken, was den Erfolg heute schon bremst, und es gezielt beenden.\n\n1. Maximal scheitern (10 Min.)\nAktion: Tragen Sie das Ziel oben ein. Kleingruppen sammeln alles, was das Ziel garantiert scheitern ließe.\nRegel: Übertreiben ist erwünscht. Je absurder, desto besser.\n\n2. Ehrlich prüfen (10 Min.)\nAktion: Gehen Sie die Liste durch: Was davon passiert heute schon, auch nur ein bisschen? Diese Notizen wandern in Spalte 2.\nTipp: Hier wird es ernst. Sorgen Sie für eine offene, wertschätzende Atmosphäre.\n\n3. Stoppen (10 Min.)\nAktion: Legen Sie für jede Notiz in Spalte 2 fest, wie Sie damit aufhören, und den ersten konkreten Schritt.\nZiel: Wenige, klare Stopp-Vereinbarungen mit verantwortlicher Person.\n\n🛠️ Ihre Rolle als Moderation\nSpielleitung: Laden Sie in Schritt 1 ausdrücklich zum Übertreiben ein.\nBrückenbauer: Führen Sie behutsam vom Lachen zur ehrlichen Selbstprüfung.\n\nNach „Making Space with TRIZ“ von Henri Lipmanowicz und Keith McCandless, Liberating Structures (liberatingstructures.com, CC BY-SA 4.0). Eigene Beschreibung.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"Zo2kyaN0nFS7-dloU-xxN"}]}]}}