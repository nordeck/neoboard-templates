ontFamily":"Inter","textSize":24,"textBold":true,"textAlignment":"center","textColor":"#000000","attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"4krz_h5Sd7_yGt4_ZHzSf","type":"shape","kind":"rectangle","fillColor":"#fcd0cc","position":{"x":8680,"y":5215},"width":584,"height":605,"text":"","textFontFamily":"Inter","borderRadius":12,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"dceTn_GthgG1GCrlrSEIn","type":"shape","kind":"rectangle","fillColor":"#f9a19a","position":{"x":9084,"y":5640},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"DoYtwwZvk74va1nRApcf7","type":"shape","kind":"rectangle","fillColor":"#f9a19a","position":{"x":9072,"y":5628},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"O-Ed9VuEzjRcQC1QwGVhz","type":"path","kind":"line","position":{"x":9270,"y":5070},"points":[{"x":0,"y":0},{"x":32,"y":0}],"strokeColor":"#35464d","endMarker":"arrow-head-line","attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"FYnhMJoHIurL_bqWl6k1-","type":"shape","kind":"rectangle","fillColor":"#ffc107","position":{"x":9308,"y":5030},"width":584,"height":80,"text":"2 · Check honestly","textFontFamily":"Inter","textSize":34,"textBold":true,"textColor":"#000000","attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"XhHzjQFLg-yVWMvu9wAr0","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":9308,"y":5115},"width":584,"height":90,"text":"Which of these are we already doing, knowingly or not?","textFontFamily":"Inter","textSize":24,"textBold":true,"textAlignment":"center","textColor":"#000000","attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"eKmvJkt6vDFJFm1f7TPyi","type":"shape","kind":"rectangle","fillColor":"#ffefc1","position":{"x":9308,"y":5215},"width":584,"height":605,"text":"","textFontFamily":"Inter","borderRadius":12,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"NSMZZf3oulO04pHEy0K9i","type":"shape","kind":"rectangle","fillColor":"#ffe083","position":{"x":9712,"y":5640},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"Nn1NABpWbg7f4jthH_qbb","type":"shape","kind":"rectangle","fillColor":"#ffe083","position":{"x":9700,"y":5628},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"JXAtCNLwsubKCpX-6OMO_","type":"path","kind":"line","position":{"x":9898,"y":5070},"points":[{"x":0,"y":0},{"x":32,"y":0}],"strokeColor":"#35464d","endMarker":"arrow-head-line","attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"uRNRPQkQHI7IGY-vWMUTa","type":"shape","kind":"rectangle","fillColor":"#4caf50","position":{"x":9936,"y":5030},"width":584,"height":80,"text":"3 · Stop it","textFontFamily":"Inter","textSize":34,"textBold":true,"textColor":"#ffffff","attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"SzpMdI7vLfNXChSp5uVTR","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":9936,"y":5115},"width":584,"height":90,"text":"How do we stop doing it? What is the first step?","textFontFamily":"Inter","textSize":24,"textBold":true,"textAlignment":"center","textColor":"#000000","attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"Mj2ENQmmLA-vSD7_-Ee8O","type":"shape","kind":"rectangle","fillColor":"#d2ebd3","position":{"x":9936,"y":5215},"width":584,"height":605,"text":"","textFontFamily":"Inter","borderRadius":12,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"Wfnx5MH2OO3iVA20Bx_9v","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10340,"y":5640},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"y0zbrmtBrve-JvwUhKZmS","type":"shape","kind":"rectangle","fillColor":"#a5d7a7","position":{"x":10328,"y":5628},"width":150,"height":150,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"FRdlhh9bREvmJt01R7Shf"},{"id":"EX5kYIRVOWEOITz5MYErW","type":"frame","position":{"x":10680,"y":4770},"width":1800,"height":1260,"attachedElements":["Ksm4rwYwa6KFytvorL0H8","0G5C3FGXkszQEU932XzZy"]},{"id":"Ksm4rwYwa6KFytvorL0H8","type":"shape","kind":"rectangle","fillColor":"#607d8b","position":{"x":10720,"y":4770},"width":1720,"height":120,"text":"Facilitation guide","textFontFamily":"Inter","textSize":56,"textBold":true,"textAlignment":"left","textColor":"#ffffff","attachedFrame":"EX5kYIRVOWEOITz5MYErW"},{"id":"0G5C3FGXkszQEU932XzZy","type":"shape","kind":"rectangle","fillColor":"transparent","position":{"x":10740,"y":4940},"width":1680,"height":1060,"text":"🚀 TRIZ: How it works in 3 steps\n\n🎯 Purpose: Uncover, with a wink, what is already holding success back today, and stop it deliberately.\n\n1. Fail completely (10 min)\nAction: Write the goal at the top. Small groups collect everything that would make the goal fail for certain.\nRule: Exaggeration is welcome. The more absurd, the better.\n\n2. Check honestly (10 min)\nAction: Go through the list: which of these already happen today, even a little? Move those notes to column 2.\nTip: This is where it gets serious. Keep the atmosphere open and respectful.\n\n3. Stop it (10 min)\nAction: For each note in column 2, decide how to stop it and the first concrete step.\nGoal: A few clear agreements on what to stop, each with an owner.\n\n🛠️ Your role as facilitator\nGame master: Explicitly invite exaggeration in step 1.\nBridge builder: Guide gently from laughter to honest self-reflection.\n\nBased on \"Making Space with TRIZ\" by Henri Lipmanowicz and Keith McCandless, Liberating Structures (liberatingstructures.com, CC BY-SA 4.0). Own description.","textFontFamily":"Inter","textSize":28,"textAlignment":"left","textColor":"#000000","attachedFrame":"EX5kYIRVOWEOITz5MYErW"}]}]}}