,"y":5070},"type":"shape","kind":"rectangle","width":140,"text":"","textFontFamily":"Inter","stickyNote":true,"attachedFrame":"nqbWnfxZx27V1rFjBXhIX"},{"id":"NALV8TG2yyO_987qkSWgI","fillColor":"transparent","height":80,"position":{"x":9120,"y":4990},"type":"shape","kind":"rectangle","width":460,"text":"CONTINUE / BEIBEHALTEN","attachedFrame":"nqbWnfxZx27V1rFjBXhIX","textSize":32,"textBold":true},{"id":"uXXcSENC9S3YaeAFBvIzI","fillColor":"transparent","height":80,"position":{"x":9620,"y":4990},"type":"shape","kind":"rectangle","width":300,"text":"STOP / BEENDEN","attachedFrame":"nqbWnfxZx27V1rFjBXhIX","textSize":32,"textBold":true},{"id":"61QIwU51k6Zw4BScLPPVu","fillColor":"transparent","height":80,"position":{"x":8960,"y":5510},"type":"shape","kind":"rectangle","width":620,"text":"INVENT / ERFINDEN - QUERDENKEN","attachedFrame":"nqbWnfxZx27V1rFjBXhIX","textSize":32,"textBold":true},{"id":"3zYIc14LnbsKA2UH3mwaw","fillColor":"transparent","height":80,"position":{"x":9620,"y":5510},"type":"shape","kind":"rectangle","width":480,"text":"ACT / UMSETZEN - MACHEN","attachedFrame":"nqbWnfxZx27V1rFjBXhIX","textSize":32,"textBold":true},{"id":"IH1LJPGBA6zyF8W9JxrIy","fillColor":"transparent","height":200,"position":{"x":9640,"y":5050},"type":"shape","kind":"rectangle","width":240,"text":"Was hält uns auf? \nWelch Gewohnheiten müssen wir sofort beenden?","textFontFamily":"Inter","textSize":24,"attachedFrame":"nqbWnfxZx27V1rFjBXhIX","textAlignment":"left"},{"id":"c-Xo2trMkwgRW2-E0IR5A","fillColor":"transparent","height":140,"position":{"x":9220,"y":5070},"type":"shape","kind":"rectangle","width":340,"text":"\tWas lief super?\nWelche erfolgreichen Abläufe oder Routinen müssen wir unbedingt beibehalten?","textFontFamily":"Inter","textSize":24,"attachedFrame":"nqbWnfxZx27V1rFjBXhIX","textAlignment":"left"},{"id":"53hm3JN_dmvxCkscGRgxf","fillColor":"transparent","height":180,"position":{"x":9220,"y":5570},"type":"shape","kind":"rectangle","width":340,"text":"Wenn wir unbegrenzte Ressourcen hätten: Welche völlig neue, kreative Lösung würde unsere größten Probleme lösen?","textFontFamily":"Inter","textSize":24,"attachedFrame":"nqbWnfxZx27V1rFjBXhIX","textAlignment":"left"},{"id":"wMiosulFsLkEnhPG3iybI","fillColor":"transparent","height":180,"position":{"x":9640,"y":5570},"type":"shape","kind":"rectangle","width":340,"text":"Wie setzen wir das um?\nWelche konkreten Schritte gehen wir an, und wer übernimmt dafür die Verantwortung?","textFontFamily":"Inter","textSize":24,"attachedFrame":"nqbWnfxZx27V1rFjBXhIX","textAlignment":"left"},{"id":"ey-xK9te-fhzZA6n18iTP","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"3uvUeMDRDWwQ-qxYZ6cmB","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"ShcQvPXUk1T_jzstoDj34","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1060,"fillColor":"transparent","text":"🚀 Retrospektive: Der Ablauf in 5 Schritten\n\n🎯 Wofür: Gemeinsam zurückblicken und Verbesserungen vereinbaren, die wirklich umgesetzt werden.\n\n1. Einstimmen (5 Min.)\nAktion: Benennen Sie den Zeitraum und vereinbaren Sie: offen, wertschätzend, ohne Schuldzuweisung.\n\n2. Sammeln (10 Min., in Stille)\nAktion: Jeder beschreibt Karten aus den Farbstapeln und legt sie in die Felder BEIBEHALTEN, BEENDEN und ERFINDEN.\nRegel: Ein Gedanke pro Karte. Die Leitfragen helfen beim Einstieg.\n\n3. Vorstellen und clustern (15 Min.)\nAktion: Reihum stellt jeder seine Karten kurz vor. Ähnliches wird zusammengeschoben.\n\n4. Priorisieren (5 Min.)\nAktion: Dot-Voting mit z. B. 3 Punkten pro Person.\n\n5. Umsetzen (15 Min.)\nAktion: Leiten Sie für die Top-Themen im Feld UMSETZEN konkrete Schritte ab: Was, wer, bis wann?\nZiel: 1–3 Maßnahmen. Diese Karten können Sie auf das Board „Verantwortlichkeiten / Timeline\" mitnehmen.\n\n🛠️ Ihre Rolle als Moderator\nSchutzraum: Achten Sie darauf, dass Probleme benannt werden, nicht Personen.\nZeitwächter: Reservieren Sie genug Zeit für UMSETZEN.\nNachhalter: Starten Sie die nächste Retro mit dem Blick auf die vereinbarten Maßnahmen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"3uvUeMDRDWwQ-qxYZ6cmB","textSize":26,"textColor":"#000000"}]}]}}