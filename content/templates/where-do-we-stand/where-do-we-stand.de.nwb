dFrame":"Mj5rpqPEhaLtrADqHDjCg"},{"id":"D1Q8CUXiuYe3Z7VM7ssOs","fillColor":"transparent","height":80,"position":{"x":8680,"y":5020},"type":"shape","kind":"rectangle","width":300,"text":"weiter so","textFontFamily":"Abel","textSize":48,"attachedFrame":"Mj5rpqPEhaLtrADqHDjCg","textAlignment":"left"},{"id":"uhclElDlB8r2SVaurn7dO","fillColor":"transparent","height":80,"position":{"x":10200,"y":5020},"type":"shape","kind":"rectangle","width":320,"text":"lieber lassen","textFontFamily":"Abel","attachedFrame":"Mj5rpqPEhaLtrADqHDjCg","textAlignment":"right","textSize":48},{"id":"dTKNZgM26_1Lu1CxFnWRb","fillColor":"transparent","height":80,"position":{"x":8680,"y":5820},"type":"shape","kind":"rectangle","width":500,"text":"neu beginnen / ändern","textFontFamily":"Abel","attachedFrame":"Mj5rpqPEhaLtrADqHDjCg","textAlignment":"left","textSize":48},{"id":"TFiEf2z2fbgku7FmRnAvb","fillColor":"transparent","height":80,"position":{"x":10220,"y":5820},"type":"shape","kind":"rectangle","width":300,"text":"Risiken","textFontFamily":"Abel","attachedFrame":"Mj5rpqPEhaLtrADqHDjCg","textAlignment":"right","textSize":48},{"id":"7YKj9GF1BfUO5lUVrrzXs","type":"shape","kind":"rectangle","position":{"x":10720,"y":4860},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"SM05qVI41n-9zLPV5MJtn","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"UmJlZHwONkwduP4ob7YPk","type":"shape","kind":"rectangle","position":{"x":10740,"y":5030},"width":1680,"height":930,"fillColor":"transparent","text":"🚀 Wo stehen wir? Der Ablauf in 4 Schritten\n\n🎯 Wofür: Den aktuellen Stand einer Zusammenarbeit oder eines Projekts ehrlich einschätzen.\n\n1. Einführen (2 Min.)\nAktion: Erklären Sie die vier Felder:\nweiter so – was funktioniert und soll bleiben?\nlieber lassen – was kostet Kraft ohne Nutzen?\nneu beginnen / ändern – was fehlt oder muss anders werden?\nRisiken – was könnte uns gefährden?\n\n2. Sammeln (10 Min.)\nAktion: Jeder schreibt Karten und legt sie in die Felder.\nRegel: Konkrete Beispiele statt allgemeiner Urteile.\n\n3. Besprechen (15–20 Min.)\nAktion: Gehen Sie Feld für Feld durch, clustern Sie Ähnliches und klären Sie Unklares.\n\n4. Überleiten (5 Min.)\nAktion: Markieren Sie die Karten, die in die Priorisierung gehen (nächster Rahmen).\n\n🛠️ Ihre Rolle als Moderator\nFairness-Hüter: Achten Sie darauf, dass beide Seiten zu Wort kommen.\nRisiko-Lotse: Nehmen Sie Risiken ernst, ohne in Problemlösung abzudriften.\nZeitwächter: Halten Sie das Besprechen knapp.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"SM05qVI41n-9zLPV5MJtn","textSize":24,"textColor":"#000000"}]}]}}