ZWPH3CL"},{"id":"mQ2KDRvcTzYtOwSISXFM0","fillColor":"#00bcd4","height":80,"position":{"x":8700,"y":5750},"type":"shape","kind":"rectangle","width":80,"text":"","attachedFrame":"oQA9J9divWM3KMZWPH3CL"},{"id":"e2P_f1T5J5E_qlUPQC9Ox","fillColor":"#00bcd4","height":80,"position":{"x":8740,"y":5790},"type":"shape","kind":"rectangle","width":80,"text":"","attachedFrame":"oQA9J9divWM3KMZWPH3CL"},{"id":"tb6TrjDML8jLiJ2nXBxzt","fillColor":"#00bcd4","height":80,"position":{"x":8780,"y":5830},"type":"shape","kind":"rectangle","width":80,"text":"","attachedFrame":"oQA9J9divWM3KMZWPH3CL"},{"id":"0x5jULPzC3MXlTsm3LK6d","fillColor":"#8bc34a","height":80,"position":{"x":9400,"y":5150},"type":"shape","kind":"rectangle","width":80,"text":"","attachedFrame":"oQA9J9divWM3KMZWPH3CL"},{"id":"ZGCF8sZVfUeO9Dz251GqU","attachedFrame":"oQA9J9divWM3KMZWPH3CL","fillColor":"#d7dee2","height":140,"position":{"x":8640,"y":4770},"type":"shape","kind":"rectangle","width":60,"text":"","textColor":"#8e3013","textFontFamily":"Inter","textSize":64},{"id":"A0AN2rRbE4qCTCRJMBnZ_","attachedFrame":"oQA9J9divWM3KMZWPH3CL","fillColor":"#d7dee2","height":140,"position":{"x":8700,"y":4770},"type":"shape","kind":"rectangle","width":1860,"text":"SWOT Strategy","textSize":64,"textBold":true,"textAlignment":"left"},{"id":"D2K6EuDukejTAfYPxqcYC","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Facilitation guide","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"Ms1_aPOGluwtqxJ_fLoIf","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"HsfXW1ZdrhW51cy8kPOX3","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1060,"fillColor":"transparent","text":"🚀 SWOT Strategy: How it works in 4 steps\n\n🎯 Purpose: Derive concrete strategies from a SWOT analysis.\n\n1. Transfer the SWOT (10 min)\nAction: Place the top Strengths and Weaknesses in the \"Company\" rows and the top Chances and Risks in the \"Environment\" columns.\n\n2. Combine (30 min)\nAction: Work through the four fields:\nDEVELOP (strengths × chances): use strengths to seize chances.\nPROTECT (strengths × risks): use strengths to defend against risks.\nREGAIN (weaknesses × chances): use chances to overcome weaknesses.\nAVOID (weaknesses × risks): reduce exposure where both meet.\nRule: Each strategy card names the factors it combines.\n\n3. Prioritise (10 min)\nAction: Rate strategies by impact and effort, dot-vote the top 3.\n\n4. Plan (15 min)\nAction: Give each top strategy an owner and a first step.\n\n🛠️ Your role as facilitator\nConnector: Ask \"Which strength helps with this chance?\"\nRealist: Keep strategies concrete and testable.\nDecider: Close with clear owners.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"Ms1_aPOGluwtqxJ_fLoIf","textSize":26,"textColor":"#000000"},{"id":"O-eHDDrtFcu2djtlBqRjP","type":"shape","kind":"rectangle","position":{"x":12640,"y":4770},"width":1920,"height":120,"fillColor":"#ff5722","text":"METADATEN · T08 · wird vor Veröffentlichung entfernt","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zEhrMyZOiZnLQKxII5CVg","textSize":44,"textColor":"#ffffff","textBold":true},{"id":"Uzu6VvUg-D2NFYryqgrqB","type":"shape","kind":"rectangle","position":{"x":12640,"y":4910},"width":1920,"height":130,"fillColor":"transparent","text":"Template-ID: T08   ·   Datei: T08_swot-strategy.en.nwb   ·   Board-Format: v2 (Infinite Canvas)\nQuelle: Schnellstart_Paket.nwb (= Schnellstart_Templates.nwb) › Rahmen 6\nAusfüllen: In „Ihr Eintrag\" eigenen Text schreiben oder ✓ setzen, um den Vorschlag zu übernehmen. Leer = noch offen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zEhrMyZOiZnLQKxII5CVg","textSize":22,"textColor":"#000000"},{"id":"oFONR07dLqDLpObVzTa8S","type":"shape","kind":"rectangle","position":{"x":12640,"y":5060},"width":430,"height":60,"fillColor":"#607d8b","text":"Feld","textFontFamily":"Inter","textAlignment":"le