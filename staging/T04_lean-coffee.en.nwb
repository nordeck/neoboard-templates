8.57142857142857,"position":{"x":8700,"y":5850},"type":"shape","kind":"ellipse","width":240,"text":"","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4"},{"id":"8Rxyee_PFhNjPfjwfiZ7X","fillColor":"#ffeb3b","height":68.57142857142857,"position":{"x":8700,"y":5890},"type":"shape","kind":"ellipse","width":240,"text":"","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4"},{"id":"neQEtv0SabMg2l8KVvg5U","fillColor":"#00bcd4","height":68.57142857142857,"position":{"x":8700,"y":5930},"type":"shape","kind":"ellipse","width":240,"text":"add topic to topic collection","attachedFrame":"Vc3W93F_L4YKcYj1VpUD4","textItalic":true,"textSize":16},{"id":"JJYqc36D9IZqFKbgTBH_2","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Facilitation guide","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zy-PzjyQUq7cU7-ANasMX","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"Yk1i1qnLFwUONcc3nYU2U","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1074,"fillColor":"transparent","text":"🚀 Lean Coffee: How it works in 4 steps\n\n🎯 Purpose: A meeting without a fixed agenda. The group decides what matters most.\n\n1. Collect topics (3–5 min)\nAction: Everyone writes topic ideas on cards (add topic to topic collection).\nRule: One topic per card. Short and clear.\nGoal: All cards in \"Topic Collection\".\n\n2. Prioritise with dot voting (3 min)\nAction: Everyone gets a fixed number of votes (e.g. 3 dots).\nRule: Votes can be distributed freely, even all on one topic.\nGoal: Sort the top cards into \"Topic Selection\". This is your agenda.\n\n3. Discuss with timeboxing (core phase)\nAction: Move the top topic to \"Topic Discussion\" and start a 5-minute timer.\nThe pitch: The topic owner explains it in 30–60 seconds, then everyone joins in.\n\n4. Extend or close (Roman vote)\nWhen time is up, the group votes by hand signal:\n👍 Thumbs up: Still hot. Extend by 2–3 minutes (once per topic).\n👎 Thumbs down: Done. Move the card to \"Done Topics\", start the next one.\n✊ Sideways: Don't mind / abstain.\nNote follow-ups in \"Action Items\".\n\n🛠️ Your role as facilitator\nTimekeeper: Keep the timer visible and stop consistently.\nVisualiser: Move cards in sync with the conversation.\nFocus keeper: Gently bring the group back to the card's topic.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zy-PzjyQUq7cU7-ANasMX","textSize":24,"textColor":"#000000"},{"id":"S09dwMa5O5Cg3r4YddZRP","type":"shape","kind":"rectangle","position":{"x":12640,"y":4770},"width":1920,"height":120,"fillColor":"#ff5722","text":"METADATEN · T04 · wird vor Veröffentlichung entfernt","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"hLrwqTRB1fXCZ2zxjSTQE","textSize":44,"textColor":"#ffffff","textBold":true},{"id":"itXTc13aDFhayj4wV3SAp","type":"shape","kind":"rectangle","position":{"x":12640,"y":4910},"width":1920,"height":130,"fillColor":"transparent","text":"Template-ID: T04   ·   Datei: T04_lean-coffee.en.nwb   ·   Board-Format: v2 (Infinite Canvas)\nQuelle: Schnellstart_Paket.nwb (= Schnellstart_Templates.nwb) › Rahmen 3\nAusfüllen: In „Ihr Eintrag\" eigenen Text schreiben oder ✓ setzen, um den Vorschlag zu übernehmen. Leer = noch offen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"hLrwqTRB1fXCZ2zxjSTQE","textSize":22,"textColor":"#000000"},{"id":"T1TCo6Oei0oVzy6y9Ak3I","type":"shape","kind":"rectangle","position":{"x":12640,"y":5060},"width":430,"height":60,"fillColor":"#607d8b","text":"Feld","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"hLrwqTRB1fXCZ2zxjSTQE","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"SudNjqLu1OL23A0WDh2wL","type":"shape","kind":"rectangle","position":{"x":13090,"y":5060},"width":690,"height":60,"fillColor":"#607d8b","text":"Vorschlag","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"hLrwqTRB1fXCZ2zxjSTQE","textSize":24,"textColor":"#ffffff","textBold":true},{"i