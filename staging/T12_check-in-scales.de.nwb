AlLY","fillColor":"#673ab7","height":20,"position":{"x":8820,"y":5270},"type":"shape","kind":"ellipse","width":20,"text":"","textFontFamily":"Inter","attachedFrame":"mbIMBFrNCi4iZqPVK2Hb1"},{"id":"z5ho9rOE0mGAwJ9A2TCgs","fillColor":"#673ab7","height":20,"position":{"x":8700,"y":5390},"type":"shape","kind":"ellipse","width":20,"text":"","textFontFamily":"Inter","attachedFrame":"mbIMBFrNCi4iZqPVK2Hb1"},{"id":"BN0w-BDgOwKZiClgKIlaS","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"HH-YVZvKne-8HMI9wLgVg","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"p-nCfCGzQQXQaJz7QTqh4","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1060,"fillColor":"transparent","text":"🚀 Check-in: Der Ablauf in 3 Schritten\n\n🎯 Wofür: Ankommen, Stimmung sichtbar machen und Erwartungen erkennen, bevor die eigentliche Arbeit beginnt.\n\n1. Aussagen vorstellen (1 Min.)\nAktion: Lesen Sie die drei Aussagen vor. Passen Sie sie vorab an Ihren Anlass an.\n\n2. Punkte setzen (2–3 Min.)\nAktion: Jeder nimmt sich drei Punkte vom Stapel links und setzt pro Aussage einen Punkt auf die Skala.\nRegel: Ehrlich und spontan, es gibt kein richtig oder falsch.\n\n3. Kurz spiegeln (2–5 Min.)\nAktion: Beschreiben Sie das Bild: Wo häufen sich die Punkte? Gibt es Ausreißer?\nZiel: Die Gruppe weiß, wo sie steht. Bei Bedarf greifen Sie Ausreißer behutsam auf.\n\n🛠️ Ihre Rolle als Moderator\nGastgeber: Starten Sie mit einem eigenen Punkt, das senkt die Hemmschwelle.\nBeobachter: Werten Sie nicht, sondern beschreiben Sie.\nBrückenbauer: Greifen Sie das Ergebnis im Check-out wieder auf.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"HH-YVZvKne-8HMI9wLgVg","textSize":32,"textColor":"#000000"},{"id":"7B5Y9g-XFX259hoTXsIm5","type":"shape","kind":"rectangle","position":{"x":12640,"y":4770},"width":1920,"height":120,"fillColor":"#ff5722","text":"METADATEN · T12 · wird vor Veröffentlichung entfernt","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"T9A9kD0rJtDiazSl3cNbU","textSize":44,"textColor":"#ffffff","textBold":true},{"id":"qBCit0R_U-Ii-BzL8NGD3","type":"shape","kind":"rectangle","position":{"x":12640,"y":4910},"width":1920,"height":130,"fillColor":"transparent","text":"Template-ID: T12   ·   Datei: T12_check-in-scales.de.nwb   ·   Board-Format: v2 (Infinite Canvas)\nQuelle: Workshops_Retro_und_Lean_Coffee_2.nwb › Rahmen 2\nAusfüllen: In „Ihr Eintrag\" eigenen Text schreiben oder ✓ setzen, um den Vorschlag zu übernehmen. Leer = noch offen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"T9A9kD0rJtDiazSl3cNbU","textSize":22,"textColor":"#000000"},{"id":"XoQD7QN9oPri6f1cxT3vr","type":"shape","kind":"rectangle","position":{"x":12640,"y":5060},"width":430,"height":60,"fillColor":"#607d8b","text":"Feld","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"T9A9kD0rJtDiazSl3cNbU","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"tXX0_xLk4q1o20yIu1zd-","type":"shape","kind":"rectangle","position":{"x":13090,"y":5060},"width":690,"height":60,"fillColor":"#607d8b","text":"Vorschlag","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"T9A9kD0rJtDiazSl3cNbU","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"Hgy4m_anjL57i00ZnRE7m","type":"shape","kind":"rectangle","position":{"x":13800,"y":5060},"width":760,"height":60,"fillColor":"#607d8b","text":"Ihr Eintrag","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"T9A9kD0rJtDiazSl3cNbU","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"dZVCrgqYpUUbpfB_booE2","type":"shape","kind":"rectangle","position":{"x":12640,"y":5128},"width":430,"height":93,"fillColor":"#d7dee2","text":"Veröffentlichen?\n[publish]","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"T9A9kD0rJtDiazSl3cNbU","textSize":24,"textColor":"#00000