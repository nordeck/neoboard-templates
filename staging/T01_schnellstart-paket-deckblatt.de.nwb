H_oQKB7I1","SETDgl4uQF-L-OFg1NCC8","7ibAas7i6IxC46SZPAXnB"]},{"id":"gI-q36W2KvPQqkWsIHwu8","fillColor":"#d7dee2","height":200,"position":{"x":8640,"y":4860},"type":"shape","kind":"rectangle","width":1700,"text":"Whiteboard – Schnellstart-Paket","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":96,"textBold":true,"textAlignment":"center"},{"id":"vafNYws_agQIfbYYksiKz","fillColor":"transparent","height":540,"position":{"x":8740,"y":5160},"type":"shape","kind":"rectangle","width":1200,"text":"Mit diesem Schnellstart-Paket können Sie sofort beginnen. Es enthält verschiedene Vorlagen für unterschiedliche Anwendungsfälle, die Sie einfach nutzen, anpassen und erweitern können. So müssen Sie sich nicht um die Gestaltung der Inhalte kümmern, sondern können sich direkt auf das konzentrieren, was für Sie und Ihre Teilnehmenden wichtig ist, und unmittelbar produktiv arbeiten.\n\n","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textAlignment":"left","textSize":48},{"id":"oDMDLGi5115fZs9ngoXrD","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5140},"type":"shape","kind":"rectangle","width":600,"text":"--> 2 - Mindmap","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"-2rot3yO7Bstv2R32Aiy4","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5380},"type":"shape","kind":"rectangle","width":600,"text":"--> 5 - Retrospektive","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"IT5AvHafMmaak8PsAukF4","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5220},"type":"shape","kind":"rectangle","width":600,"text":"--> 3 - Kanban-Board","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"N1E-TYi98HFY4sv0pd85T","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5300},"type":"shape","kind":"rectangle","width":600,"text":"--> 4 - Lean Coffee-Board","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"xXQKFhdI4Qqnoc3lb3lU1","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5540},"type":"shape","kind":"rectangle","width":600,"text":"--> 7 - SWOT-Analyse","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"pZ0Tz7k17F7aZIU9fky2c","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5620},"type":"shape","kind":"rectangle","width":600,"text":"--> 8 - SWOT-Strategie","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"AXC8rf_DWc67C46IEf5DV","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5780},"type":"shape","kind":"rectangle","width":600,"text":"--> 10 - Timeline","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"s4YtQNQEn4s9vO_2KUbig","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5700},"type":"shape","kind":"rectangle","width":600,"text":"--> 9 - Projekt-Timeline","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"FI_U1q48YbrKzWJtU5WxE","fillColor":"#d9cded","height":60,"position":{"x":9960,"y":5460},"type":"shape","kind":"rectangle","width":600,"text":"--> 6 - Business Modell Canvas","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left","textBold":true},{"id":"9Ng5lVEsfc2tDXwAiYdsR","fillColor":"#d7dee2","height":200,"position":{"x":10260,"y":4860},"type":"shape","kind":"rectangle","width":300,"text":"","textColor":"#8e3013","textFontFamily":"Inter","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":96},{"id":"1HO9nGJcBE10PfBfJeerC","fillColor":"transparent","height":133.787109375,"position":{"x":8720,"y":5740},"type":"shape","kind":"rectangle","width":1240,"text":"Viel Erfolg und einen gelungenen Workshop!","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textAlignment":"left","textSize":48,"textBold":true,"textColor":"#673ab7"},{"id":"6pSq5v2PtePvO1bi9n-5P","fillColor":"#d9cded","textBold":true,"height":60,"position":{"x":9960,"y":5860},"type":"shape","kind":"rectangle","width":600,"text":"--> 11 - Mind Map (2)","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textSize":32,"textAlignment":"left"},{"id":"SXRftEx10pwyjCP1dexar","fillColor":"transparent","height":80,"position":{"x":9960,"y":5060},"type":"shape","kind":"rectangle","width":400,"text":"Rahmennummer und Inhalt","textColor":"#673ab7","textFontFamily":"Inter","attachedFrame":"o8kBNTqIclEgv5aJ3JcYi","textBold":true},{"id":"lrjP5we5K7KGrw2Rm3z3_","type":"shape","kind":"rectangle","position":{"x":10720,"y":4860},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"6UQZ4mjCH5poryt87cc44","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"9goJiIjfm3QAoKDdSRrp4","type":"shape","kind":"rectangle","position":{"x":10740,"y":5030},"width":1680,"height":880,"fillColor":"transparent","text":"📘 So nutzen Sie dieses Deckblatt\n\n🎯 Wofür: Einstieg in das Schnellstart-Paket. Es erklärt, welche Vorlagen enthalten sind und wofür sie gedacht sind.\n\n1. Überblick verschaffen (2 Min.)\nAktion: Lesen Sie den Einleitungstext und die Liste der Rahmen rechts.\nZiel: Die passende Vorlage für Ihr Vorhaben finden.\n\n2. Vorlage auswählen\nAktion: Springen Sie über die Rahmennavigation zur gewünschten Vorlage.\nRegel: Jede Vorlage steht für sich und kann beliebig angepasst werden.\n\n3. Loslegen\nAktion: Kopieren Sie den Rahmen bei Bedarf, damit die leere Vorlage für weitere Runden erhalten bleibt.\n\n🛠️ Ihre Rolle als Moderator\nWegweiser: Zeigen Sie den Teilnehmenden zu Beginn, wo sie die Vorlagen finden.\nGastgeber: Passen Sie den Willkommenstext an Ihren Anlass an.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"6UQZ4mjCH5poryt87cc44","textSize":28,"textColor":"#000000"},{"id":"RUE-52mF56XH6K3xsEfh6","type":"shape","kind":"rectangle","position":{"x":12640,"y":4860},"width":1920,"height":120,"fillColor":"#ff5722","text":"METADATEN · T01 · wird vor Veröffentlichung entfernt","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"QkLdYzivC1zZv3I7hRJpM","textSize":44,"textColor":"#ffffff","textBold":true},{"id":"4uY1XBlp9NfbmmuBG8M_P","type":"shape","kind":"rectangle","position":{"x":12640,"y":5000},"width":1920,"height":130,"fillColor":"transparent","text":"Template-ID: T01   ·   Datei: T01_schnellstart-paket-deckblatt.de.nwb   ·   Board-Format: v2 (Infinite Canvas)\nQuelle: Schnellstart_Paket.nwb (= Schnellstart_Templates.nwb) › Rahmen 10\nAusfüllen: In „Ihr Eintrag\" eigenen Text schreiben oder ✓ setzen, um den Vorschlag zu übernehmen. Leer = noch offen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"QkLdYzivC1zZv3I7hRJpM","textSize":22,"textColor":"#000000"},{"id":"frbuz8PkwVh0IzkjH8dwN","type":"shape","kind":"rectangle","position":{"x":12640,"y":5150},"width":430,"height":60,"fillColor":"#607d8b","text":"Feld","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"QkLdYzivC1zZv3I7hRJpM","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"7IWrAY6gDLQUwyyPlTEx9","type":"shape","kind":"rectangle","position":{"x":13090,"y":5150},"width":690,"height":60,"fillColor":"#607d8b","text":"Vorschlag","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"QkLdYzivC1zZv3I7hRJpM","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"I7Um--c6_ErKW26vJt-RW","type":"shape","kind":"rectangle","position":{"x":13800,"y":5150},"width":760,"height":60,"fillColor":"#607d8b","text":"Ihr Eintrag","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"QkLdYzivC1zZv3I7hRJpM","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"GmDlGYqpbYxLwilZLCYmW","type":"shape","kind":"rectangle","position":{"x":12640,"y":5218},"width":430,"height":93,"fillColor":"#d7dee2","text":"Veröffentlichen?\n[publish]","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"QkLdYzivC1zZv3I7hRJpM","textSize":24,"textColor":"#000000