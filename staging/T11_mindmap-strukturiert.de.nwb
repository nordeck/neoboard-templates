extSize":24},{"id":"_8IeZw9AW0fqJAlCBZwKv","type":"path","kind":"line","position":{"x":9092.678468406608,"y":5242.238793320239},"points":[{"x":146.82239485470927,"y":88.5},{"x":0,"y":0}],"strokeColor":"#bdbdbd","connectedElementStart":"uOmi5liuOxsaOkbRE7M4w","connectedElementEnd":"RoBSuLi2l7VjWmw2U1gvI","attachedFrame":"7ElT8NQ_vThn2P-3rMnj_"},{"id":"sN17q34WSC8Z0uXFYMsei","type":"shape","kind":"rectangle","fillColor":"#f9c6d8","position":{"x":9080,"y":5090},"width":175,"height":52,"text":"\n","textFontFamily":"Inter","borderRadius":15,"connectedPaths":["pojHfqMH2GBcJrZ1b8wbU"],"attachedFrame":"7ElT8NQ_vThn2P-3rMnj_","textSize":24},{"id":"pojHfqMH2GBcJrZ1b8wbU","type":"path","kind":"line","position":{"x":9182.803621506235,"y":5142.0914262227525},"points":[{"x":94.2250092524082,"y":188.6473670974883},{"x":0,"y":0}],"strokeColor":"#bdbdbd","connectedElementStart":"uOmi5liuOxsaOkbRE7M4w","connectedElementEnd":"sN17q34WSC8Z0uXFYMsei","attachedFrame":"7ElT8NQ_vThn2P-3rMnj_"},{"id":"EoSS3TQ0jwUNFalCTjq0i","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"OyQBr5VroJGJbpJLPaz_O","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"EDPi9pkduc6_TwI6-zfXU","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1080,"fillColor":"transparent","text":"🚀 Vorstrukturierte Mindmap: Der Ablauf in 4 Schritten\n\n🎯 Wofür: Ein Thema systematisch in sechs Bereiche zerlegen, z. B. für Projektplanung, Unterrichtseinheiten oder Analysen.\n\n1. Zentrum und Äste benennen (5–10 Min.)\nAktion: Tragen Sie das Thema ins dunkle Zentrum und je einen Bereich in die sechs farbigen Hauptäste ein.\nRegel: Äste sollten sich nicht überschneiden.\n\n2. Unterpunkte füllen (15–20 Min.)\nAktion: Ergänzen Sie in den hellen Feldern Details, Beispiele oder offene Fragen.\nRegel: Leere Felder sind erlaubt, zusätzliche Felder auch.\n\n3. Lücken prüfen (5–10 Min.)\nAktion: Welcher Ast ist dünn besetzt? Was fehlt ganz?\n\n4. Ergebnis sichern (5 Min.)\nAktion: Markieren Sie die wichtigsten Punkte und übertragen Sie Aufgaben auf ein Kanban- oder Timeline-Board.\n\n🛠️ Ihre Rolle als Moderator\nStrukturgeber: Klären Sie die sechs Äste gemeinsam, bevor gefüllt wird.\nAufteiler: Lassen Sie Kleingruppen je einen Ast bearbeiten.\nVerdichter: Fassen Sie am Ende pro Ast eine Kernaussage zusammen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"OyQBr5VroJGJbpJLPaz_O","textSize":28,"textColor":"#000000"},{"id":"akzb5uwQrUg-fFTqy2mpM","type":"shape","kind":"rectangle","position":{"x":12640,"y":4770},"width":1920,"height":120,"fillColor":"#ff5722","text":"METADATEN · T11 · wird vor Veröffentlichung entfernt","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zvQynMQEaJ0nyID2rr4iX","textSize":44,"textColor":"#ffffff","textBold":true},{"id":"XYbpfmZMm2dyLEKxCWf2I","type":"shape","kind":"rectangle","position":{"x":12640,"y":4910},"width":1920,"height":130,"fillColor":"transparent","text":"Template-ID: T11   ·   Datei: T11_mindmap-strukturiert.de.nwb   ·   Board-Format: v2 (Infinite Canvas)\nQuelle: Schnellstart_Paket.nwb (= Schnellstart_Templates.nwb) › Rahmen 11\nAusfüllen: In „Ihr Eintrag\" eigenen Text schreiben oder ✓ setzen, um den Vorschlag zu übernehmen. Leer = noch offen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zvQynMQEaJ0nyID2rr4iX","textSize":22,"textColor":"#000000"},{"id":"UDCz7THsykSkrb54903Tt","type":"shape","kind":"rectangle","position":{"x":12640,"y":5060},"width":430,"height":60,"fillColor":"#607d8b","text":"Feld","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"zvQynMQEaJ0nyID2rr4iX","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"wOZKLOpm-f7vUcX1uOetB","type":"shape","kind":"rectangle","position":{"x":13090,"y":5060},"width":690,"height":60,"fillColor":"#607d8b","text":"Vorschlag","textFontFami