e","width":200,"text":"","attachedFrame":"q-6vL_3eJsdJOBwOjaw0J"},{"id":"xbomljSLMnHR4js3CMAiI","fillColor":"#e6ed9c","height":80,"position":{"x":10240,"y":5830},"type":"shape","kind":"rectangle","width":200,"text":"","attachedFrame":"q-6vL_3eJsdJOBwOjaw0J"},{"id":"CSF82uTl8__tDWjz-fJN4","fillColor":"#bfeef4","height":80,"position":{"x":8720,"y":5870},"type":"shape","kind":"rectangle","width":200,"text":"","attachedFrame":"q-6vL_3eJsdJOBwOjaw0J"},{"id":"LamDpe45c0ICLhu0FdwOF","fillColor":"#bfeef4","height":80,"position":{"x":8760,"y":5830},"type":"shape","kind":"rectangle","width":200,"text":"","attachedFrame":"q-6vL_3eJsdJOBwOjaw0J"},{"id":"ulxoGJkAvdileAnA0K5ui","fillColor":"#d7dee2","height":140,"position":{"x":8640,"y":4770},"type":"shape","kind":"rectangle","width":60,"text":"","textColor":"#8e3013","textFontFamily":"Inter","textSize":64,"attachedFrame":"q-6vL_3eJsdJOBwOjaw0J"},{"id":"-lRawp8w1VsUFNA_O7E39","fillColor":"#d7dee2","height":140,"position":{"x":8700,"y":4770},"type":"shape","kind":"rectangle","width":1860,"text":"Mindmap","textSize":64,"textBold":true,"textAlignment":"left","attachedFrame":"q-6vL_3eJsdJOBwOjaw0J"},{"id":"bvF4_XtH_GzyUIn4xa-JS","type":"shape","kind":"rectangle","position":{"x":10720,"y":4770},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"khLeMNFoAg3DpcFBt249z","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"tSYyRi5T2M9fApDNrZSNX","type":"shape","kind":"rectangle","position":{"x":10740,"y":4940},"width":1680,"height":1060,"fillColor":"transparent","text":"🚀 Mindmap: Der Ablauf in 4 Schritten\n\n🎯 Wofür: Gedanken zu einem Thema sammeln, strukturieren und Zusammenhänge sichtbar machen.\n\n1. Zentrum festlegen (2 Min.)\nAktion: Schreiben Sie den Begriff oder die Leitfrage in das zentrale Feld.\nRegel: Kurz und eindeutig formulieren.\n\n2. Hauptäste sammeln (5–10 Min.)\nAktion: Alle ziehen Haftnotizen aus den Farbstapeln und legen Hauptthemen rund um das Zentrum.\nRegel: Eine Farbe pro Hauptast, ein Gedanke pro Karte.\nZiel: 4–6 tragende Äste.\n\n3. Verzweigen (10–20 Min.)\nAktion: Ergänzen Sie zu jedem Hauptast Unterpunkte und verbinden Sie sie mit Linien.\nRegel: Erst sammeln, dann bewerten.\n\n4. Auswerten (5–10 Min.)\nAktion: Markieren Sie wichtige oder überraschende Punkte und leiten Sie nächste Schritte ab.\n\n🛠️ Ihre Rolle als Moderator\nImpulsgeber: Stellen Sie offene Fragen, wenn ein Ast stockt.\nOrdner: Fassen Sie doppelte Karten zusammen und halten Sie die Struktur übersichtlich.\nZeitwächter: Kündigen Sie den Wechsel vom Sammeln zum Auswerten an.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"khLeMNFoAg3DpcFBt249z","textSize":28,"textColor":"#000000"},{"id":"47f_9NAnhBfInkXs46SN0","type":"shape","kind":"rectangle","position":{"x":12640,"y":4770},"width":1920,"height":120,"fillColor":"#ff5722","text":"METADATEN · T02 · wird vor Veröffentlichung entfernt","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"e-fGXAvWKuGI_kgdYnhoj","textSize":44,"textColor":"#ffffff","textBold":true},{"id":"3C-s02bVJIxolweOq8K_C","type":"shape","kind":"rectangle","position":{"x":12640,"y":4910},"width":1920,"height":130,"fillColor":"transparent","text":"Template-ID: T02   ·   Datei: T02_mindmap.de.nwb   ·   Board-Format: v2 (Infinite Canvas)\nQuelle: Schnellstart_Paket.nwb (= Schnellstart_Templates.nwb) › Rahmen 1\nAusfüllen: In „Ihr Eintrag\" eigenen Text schreiben oder ✓ setzen, um den Vorschlag zu übernehmen. Leer = noch offen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"e-fGXAvWKuGI_kgdYnhoj","textSize":22,"textColor":"#000000"},{"id":"v0cfHl5LsQuuPj3qsSzZc","type":"shape","kind":"rectangle","position":{"x":12640,"y":5060},"width":430,"height":60,"fillColor":"#607d8b","text":"Feld","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"e-fGXAvWKuGI_kgdYnhoj","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"F7onbJZ6OoLZvAuo1