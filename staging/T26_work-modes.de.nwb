dth":363.40425531914866,"height":440},{"id":"jn7VPY1orVfm65zaJ4vcH","type":"image","width":92.00799056195775,"height":92.00799056195775,"position":{"x":9360,"y":5680},"mxc":"mxc://neotoolsuite.demo.nordeck.io/NSZUHsxYvKuFnrsrcHYalStm","fileName":"arrows_input_80dp_FFFFFF_FILL0_wght400_GRAD0_opsz48.svg","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"87Trhi9dp7QcbIAl0yQhF","type":"image","width":92.00799056195775,"height":92.00799056195775,"position":{"x":9360,"y":5800},"mxc":"mxc://neotoolsuite.demo.nordeck.io/JBrWfzhNMYSGbZYShUpPXSIH","fileName":"cloud_sync_80dp_000000_FILL0_wght400_GRAD0_opsz48.svg","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"_sjA_ILuDLy4LUc6BkPDD","type":"image","width":92.00799056195775,"height":92.00799056195775,"position":{"x":10220,"y":5160},"mxc":"mxc://neotoolsuite.demo.nordeck.io/MKlkNSNtisDjZIsPcFwiJSpe","fileName":"school_80dp_000000_FILL0_wght400_GRAD0_opsz48.svg","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"got3JZKFFSN4RCT8nim5u","type":"image","width":92.00799056195775,"height":92.00799056195775,"position":{"x":9780,"y":5160},"mxc":"mxc://neotoolsuite.demo.nordeck.io/qxuqFMImeBSTZnCwcDfIAGXd","fileName":"garage_door_80dp_000000_FILL0_wght400_GRAD0_opsz48.svg","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"ChxwGo0ky4iQGmpINr-pj","type":"image","width":92.00799056195775,"height":92.00799056195775,"position":{"x":9320,"y":5160},"mxc":"mxc://neotoolsuite.demo.nordeck.io/rxxnHDthzluGlxrRRuiplGWv","fileName":"travel_luggage_and_bags_80dp_000000_FILL0_wght400_GRAD0_opsz48.svg","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"oIHTLPGmGJ4zt_fMRUha7","type":"image","width":92.00799056195775,"height":92.00799056195775,"position":{"x":8900,"y":5160},"mxc":"mxc://neotoolsuite.demo.nordeck.io/HfyUcBDjJHUHjkdbffndVBcp","fileName":"apartment_80dp_000000_FILL0_wght400_GRAD0_opsz48.svg","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"HC23r0Zr0pbUCvtv2Hw0h","fillColor":"#e6e6e6","height":120,"position":{"x":8700,"y":5540},"type":"shape","kind":"triangle","width":1800,"text":"","textFontFamily":"Inter","rotation":180,"attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"fillColor":"#d9cded","height":100,"position":{"x":8640,"y":4880},"type":"shape","kind":"rectangle","width":1920.0000000000005,"text":"Zusammenarbeit unabhängig von Zeit und Ort","textFontFamily":"Inter","textSize":64,"textBold":true,"textColor":"#000000","id":"d3-Eg6qwqv1IK_WY4eeGi","attachedFrame":"bAjIwrNN-TMipVfh2iAgQ"},{"id":"qkbnpWJNh8Kba7CKrtJve","type":"shape","kind":"rectangle","position":{"x":10720,"y":4860},"width":1720,"height":120,"fillColor":"#607d8b","text":"Methodenbeschreibung","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"lYzBgQGiGcjAos3cHuwD7","textSize":56,"textColor":"#ffffff","textBold":true},{"id":"1V0IfSxRFPexUN6rDamiI","type":"shape","kind":"rectangle","position":{"x":10740,"y":5030},"width":1680,"height":880,"fillColor":"transparent","text":"🚀 Arbeitsorte & -modi: Der Ablauf in 3 Schritten\n\n🎯 Wofür: Klären, wo und wie ein Team zusammenarbeitet, und Vereinbarungen für hybride Zusammenarbeit treffen.\n\n1. Verorten (5 Min.)\nAktion: Jeder setzt einen Punkt oder eine Namenskarte unter die Orte, an denen er typischerweise arbeitet: Büro, unterwegs, remote, Unterricht.\n\n2. Modi zuordnen (5–10 Min.)\nAktion: Sammeln Sie Aufgaben auf Karten und legen Sie sie in die Zeile synchron (gleichzeitig) oder asynchron (zeitversetzt).\nRegel: Fragen Sie: Muss das wirklich gleichzeitig passieren?\n\n3. Vereinbaren (5–15 Min.)\nAktion: Leiten Sie 2–3 Vereinbarungen ab, z. B. Kernzeiten, Antwortzeiten oder feste Austauschformate.\n\n🛠️ Ihre Rolle als Moderator\nNeugierige: Fragen Sie nach Gründen, nicht nach Rechtfertigungen.\nAusgleicher: Achten Sie darauf, dass Remote-Arbeitende gleich gut eingebunden sind.\nFesthalter: Dokumentieren Sie die Vereinbarungen sichtbar auf dem Board.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"lYzBgQGiGcjAos3cHuwD7","textSize":26,"textColor":"#000000"},{"id":"jZyAD9ArRN3oVIncXf6hU","type":"shape","kind":"rectangle","position":{"x":12640,"y":4860},"width":1920,"height":120,"fillColor":"#ff5722","text":"METADATEN · T26 · wird vor Veröffentlichung entfernt","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"ek7cezSyxEG65g5hDuAwT","textSize":44,"textColor":"#ffffff","textBold":true},{"id":"wA3QfXwg110-I4WX-ARJ_","type":"shape","kind":"rectangle","position":{"x":12640,"y":5000},"width":1920,"height":130,"fillColor":"transparent","text":"Template-ID: T26   ·   Datei: T26_work-modes.de.nwb   ·   Board-Format: v2 (Infinite Canvas)\nQuelle: Beispiele.nwb › Rahmen 4\nAusfüllen: In „Ihr Eintrag\" eigenen Text schreiben oder ✓ setzen, um den Vorschlag zu übernehmen. Leer = noch offen.","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"ek7cezSyxEG65g5hDuAwT","textSize":22,"textColor":"#000000"},{"id":"qMUrSVwE_lEwtkHpl9eKb","type":"shape","kind":"rectangle","position":{"x":12640,"y":5150},"width":430,"height":60,"fillColor":"#607d8b","text":"Feld","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"ek7cezSyxEG65g5hDuAwT","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"3bgIet3MrHsnqEkJbdT_g","type":"shape","kind":"rectangle","position":{"x":13090,"y":5150},"width":690,"height":60,"fillColor":"#607d8b","text":"Vorschlag","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"ek7cezSyxEG65g5hDuAwT","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"m-NT66XzcVtwuQyyqvoF9","type":"shape","kind":"rectangle","position":{"x":13800,"y":5150},"width":760,"height":60,"fillColor":"#607d8b","text":"Ihr Eintrag","textFontFamily":"Inter","textAlignment":"left","attachedFrame":"ek7cezSyxEG65g5hDuAwT","textSize":24,"textColor":"#ffffff","textBold":true},{"id":"BtOzj215cB-na-QBRhKgj","type":"shape","kind":"rectangle","position":{"x":12640,"y":5218},"width":430,"height":93,"fillColor":"#d7dee2","text":"Veröffentlichen?\n[publish]","textFontFamily":"Inter","textAlignment":"left","attachedFrame"