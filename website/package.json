{
  "name": "neoboard-templates-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "sync:boards": "node scripts/sync-boards.mjs",
    "generate:boards": "node scripts/generate-boards.mjs",
    "validate": "node scripts/validate-content.mjs && node scripts/generate-boards.mjs --check",
    "normalize-preview": "node scripts/normalize-preview.mjs",
    "dev": "node scripts/sync-boards.mjs && astro dev",
    "build": "node scripts/validate-content.mjs && node scripts/generate-boards.mjs --check && node scripts/sync-boards.mjs && astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@fontsource/titillium-web": "5.3.0",
    "astro": "7.3.5",
    "lucide-static": "1.59.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "yaml": "2.8.1"
  }
}
