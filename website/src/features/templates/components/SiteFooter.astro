// neoboard.io footer; legal pages live on neoboard.io.
import { t } from '../lib/i18n';
import { assetHref, external } from '../lib/routes';
import type { Lang } from '../lib/templates';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = t(lang).footer;
---

<footer class="nb-site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src={assetHref('assets/neoboard-logo-white.png')} alt="NeoBoard" width="113" height="26" />
      <span>{f.developedBy} <a href={external.company} target="_blank" rel="noopener noreferrer">Nordeck IT + Consulting GmbH</a></span>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href={external.legalNotice[lang]}>{f.legalNotice}</a>
      <a href={external.contact[lang]}>{f.contact}</a>
      <a href={external.privacy[lang]}>{f.privacy}</a>
      <a href={external.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>
