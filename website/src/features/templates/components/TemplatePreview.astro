// Light 16:9 preview frame; responsive AVIF/WebP generated at build time (Teil C.2).
// Without an image (drafts in dev) it shows the category icon as a placeholder.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  icon?: string;
  label: string;
  iconSize?: number;
  widths: number[];
  sizes: string;
  loading?: 'lazy' | 'eager';
}

const { src, alt = '', icon = 'LayoutTemplate', label, iconSize = 36, widths, sizes, loading = 'lazy' } = Astro.props;
---

<div class="nb-tpreview">
  {
    src ? (
      <Picture
        src={src}
        alt={alt}
        widths={widths}
        sizes={sizes}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading={loading}
        decoding="async"
      />
    ) : (
      <div class="ph" role="img" aria-label={alt || label}>
        <Icon name={icon} size={iconSize} strokeWidth={1.6} />
        <span>{label}</span>
      </div>
    )
  }
</div>
