import type { GetStaticPaths } from 'astro';
import GalleryView from '../../../../features/templates/views/GalleryView.astro';
import { getCategories } from '../../../../features/templates/lib/templates';

export const getStaticPaths = (async () =>
  (await getCategories()).map((category) => ({ params: { id: category.id }, props: { category } }))) satisfies GetStaticPaths;

const { category } = Astro.props;
---

<GalleryView lang="de" category={category} />
